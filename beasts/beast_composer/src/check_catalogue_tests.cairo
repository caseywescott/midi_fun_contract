fn parity(index: u32) {
    let (id, nv, fx, len, hash) = *EXPECTED.span().at(index);
    let b = PackableBeastV3 {
        id,
        prefix: if nv == 0 {
            0
        } else {
            ((nv - 1) / 18 + 1).try_into().unwrap()
        },
        suffix: if nv == 0 {
            0
        } else {
            ((nv - 1) % 18 + 1).try_into().unwrap()
        },
        level: 1,
        health: 100,
        shiny: 0,
        animated: 0,
        tier: species_tier(id),
        beast_type: species_type(id),
    };
    let x = apply_performance(ComposerInputs::SoundCheck(sound_check_inputs(b)), fx);
    let x = match x {
        ComposerInputs::SoundCheck(x) => x,
        _ => panic!("check"),
    };
    let bytes = sound_check_from_inputs(x, is_mega(fx));
    let packed = midi::pack::to_felt252_array(bytes.span());
    assert_eq!(*packed.at(0), len);
    assert_eq!(core::poseidon::poseidon_hash_span(packed.span()), hash);
}
