];
#[test]
#[available_gas(1000000000)]
fn catalogue_boundaries() {
    for row in BOUNDARIES.span() {
        let (family, tonic_keynum, mode_id, len, hash) = *row;
        let x = SoundCheckInputs {
            identity: MusicIdentity { source_species_id: 0xffffffff, name_variant_id: 1242 },
            mode_id,
            tonic_keynum,
            family,
            tempo_us: 1,
            velocity_ceiling: 1,
            articulation_profile: 5,
        };
        let bytes = sound_check_from_inputs(x, true);
        let packed = midi::pack::to_felt252_array(bytes.span());
        assert_eq!(*packed.at(0), len);
        assert_eq!(core::poseidon::poseidon_hash_span(packed.span()), hash);
    }
}
