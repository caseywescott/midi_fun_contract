const STYLE_AT: [u32; 24] = [
    0, 12, 24, 38, 49, 66, 79, 91, 103, 117, 133, 149, 161, 174, 186, 202, 214, 226, 240, 255, 270,
    284, 295, 309,
];

#[derive(Drop)]
struct Reader {
    data: Span<felt252>,
    pos: u32,
    word: u256,
    left: u32,
}

/// The next 32-bit value.
#[inline(never)]
fn read(ref r: Reader) -> u32 {
    if r.left == 0 {
        r.word = (*r.data.at(r.pos)).into();
        r.pos += 1;
        r.left = 7;
    }
    let (q, v) = DivRem::div_rem(r.word, 0x100000000);
    r.word = q;
    r.left -= 1;
    v.try_into().unwrap()
}

/// A list: its length, then its items.
#[inline(never)]
fn read_list(ref r: Reader) -> Span<u32> {
    let n = read(ref r);
    let mut out: Array<u32> = array![];
    for _ in 0..n {
        out.append(read(ref r));
    }
    out.span()
}

/// `n` lists.
fn read_lists(ref r: Reader, n: u32) -> Span<Span<u32>> {
    let mut out: Array<Span<u32>> = array![];
    for _ in 0..n {
        out.append(read_list(ref r));
    }
    out.span()
}

/// Style `s` (0..STYLE_COUNT), unpacked.
#[inline(never)]
pub fn style(s: u32) -> Box<Style> {
    let mut r = Reader { data: STYLE_DATA.span(), pos: *STYLE_AT.span().at(s), word: 0, left: 0 };
    let (num, den, bpm_lo, bpm_hi, chord_bars) = (
        read(ref r), read(ref r), read(ref r), read(ref r), read(ref r),
    );
    let modes = read_list(ref r);
    let cells = read_list(ref r);
    let end = read_list(ref r);
    let accomps = read_lists(ref r, 4);
    let basses = read_lists(ref r, 3);
    let percs = read_lists(ref r, 2);
    let mut palette: Array<u8> = array![];
    for x in read_list(ref r) {
        palette.append((*x).try_into().unwrap());
    }
    let progs = read_list(ref r);
    BoxTrait::new(
        Style {
            num,
            den,
            bpm_lo,
            bpm_hi,
            modes,
            chord_bars,
            cells,
            end,
            accomps,
            basses,
            percs,
            palette: palette.span(),
            progs,
        },
    )
}
