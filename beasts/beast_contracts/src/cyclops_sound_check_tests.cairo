        bytes_to_byte_array(cyclops_sound_check_smf_bytes().span()) == reference(),
        '504 MIDI differs',
    );
}

#[test]
fn cyclops_settings_hash_matches_generator() {
    let settings = cyclops_sound_check_synth_settings();
    let mut values = array![];
    settings.serialize(ref values);
    assert(
        poseidon_hash_span(values.span()) == SERDE_HASH_CYCLOPS_SOUND_CHECK, '504 settings differ',
    );
}

