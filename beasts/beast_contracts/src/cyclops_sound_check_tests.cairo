#[test]
fn cyclops_four_effects_preserve_sequence_and_apply_standard_performance() {
    for fx in 0_u8..4 {
        let sound = compose_sound(inputs(0, 0), fx);
        assert(sound.midi == effect_reference(fx), 'Cyclops effect mismatch');
        assert(sound.settings == cyclops_sound_check_synth_settings(), 'Cyclops bank changed');
    }
}

#[test]
fn cyclops_named_effects_keep_the_same_eight_sound_sequence() {
    for fx in 0_u8..4 {
