        assert(sound.midi == effect_reference(fx), 'Cyclops named mismatch');
    }
}

fn hexof(bytes: @ByteArray) -> ByteArray {
    let mut hex: ByteArray = "";
    let mut i = 0;
    while i < bytes.len() {
        let x = bytes.at(i).unwrap();
        let (hi, lo) = DivRem::div_rem(x, 16);
        hex.append_byte(if hi < 10 {
            48 + hi
        } else {
            87 + hi
        });
        hex.append_byte(if lo < 10 {
            48 + lo
        } else {
            87 + lo
        });
        i += 1;
    }
    hex
}

#[test]
#[ignore]
fn cyclops_four_effect_captures() {
    for fx in 0_u8..4 {
        let sound = compose_sound(inputs(0, 0), fx);
        let mut settings = array![];
        Serde::serialize(@sound.settings, ref settings);
        println!(
            "CYCLOPS fx={} shash={} hex={}",
            fx,
            poseidon_hash_span(settings.span()),
            hexof(@sound.midi)
        );
    }
}
