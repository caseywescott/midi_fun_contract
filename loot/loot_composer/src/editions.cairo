//! Loot Dungeon Monthly Track Editions: the Cairo port of offchain/loot-sound/src/loot_editions.js
//! (`editionMidi` with its lab-only knobs at their defaults: plainChords false, walk and intro as the
//! purchase draws them), byte for byte. The tables (styles, numerals, colours, walking lines) are in
//! editions_data.cairo, generated by offchain/loot-sound/onchain/make_cairo_editions.mjs.
//!
//! The JS writes every part into its own track as it goes; so does this port (`Writers`), in the
//! same order. The few places the JS sorts a bar's events (the accompaniment's spread chords, the
//! intro's groove, the glissando) sort here too: events are packed into u64 keys (time, off before
//! on, insertion order) and merge-sorted, which is the JS's stable sort.
//!
//! Scale degrees are signed (i32) as in the source; `pitch` places them with an offset of 70.

use beast_composer::composition::drift::{Drift, nudge_tempo};
use beast_composer::opaque::opaque;
use core::num::traits::WrappingMul;
use midi::smf::{TrackWriter, TrackWriterTrait, smf_byte_array, smf_bytes};
use crate::common::{GLISS_CHANNEL, GlissPlan, Rng, RngTrait, fold64, gliss_plan, glissando, mix};
use crate::editions_data::{
    COLOURS, INTRO_PLAN, SCALES, STYLE_COUNT, SUBS, SUBS_AT, Style, WALKS, style,
};
use crate::species::loot_species;

const SEVEN: NonZero<u32> = 7;
const MAX_TEMPO_US: u32 = 1048575;
const MEGA_LEADS: [u32; 2] = [50, 65];
const VOL: [u32; 10] = [100, 64, 74, 100, 58, 62, 70, 100, 0, 70];
const PAN: [u8; 10] = [64, 46, 82, 64, 64, 88, 100, 76, 0, 64];
/// The forms' tunes, 2 bits each: AABA, ABAB, AABB, ABAC, ADBA, ABDB, ADBD, ABDC (A 0, B 1, C 2,
/// A' 3).
const FORMS: [u32; 8] = [16, 68, 80, 132, 28, 116, 220, 180];
const QUICKER: [u32; 9] = [0, 0, 0, 8, 14, 20, 26, 34, 42];
const SLOW_TOP: u32 = 124;
const ROT: [i32; 5] = [0, 2, 4, 7, 9];
const SNAP: [i32; 7] = [0, -1, 0, -1, 0, -1, 1];
const DRUM_FILL: [u32; 8] = [38, 38, 50, 48, 47, 45, 43, 41];
const ALT_CHANNEL: u8 = 7;
const NO_KIND: u32 = 9;
const NO_FAST: u32 = 0xffff;
/// The parts beside the lead and accompaniment (loot_editions.js PARTS): bits 0-3.
const DESCANT: u32 = 1;
const BASS: u32 = 2;
const PAD: u32 = 4;
const PERC: u32 = 8;

// ── small helpers ──

#[inline(never)]
fn m7(d: i32) -> u32 {
    let x: u32 = (d + 70).try_into().unwrap();
    let (_, r) = DivRem::div_rem(x, SEVEN);
    r
}

/// The scale a chord token plays in: the home scale (colour 0) or the colour it borrows.
#[inline(never)]
fn scale_of(home: Span<u8>, tok: u32) -> Span<u8> {
    let col = (tok / 8) % 16;
    if col == 0 {
        home
    } else {
        (*COLOURS.span().at(col)).span()
    }
}

/// `pitch(base, scale, d)`: base + 12 floor(d / 7) + scale[d mod 7].
#[inline(never)]
fn pitch(base: i32, scale: Span<u8>, d: i32) -> i32 {
    let x: u32 = (d + 70).try_into().unwrap();
    let (o, i) = DivRem::div_rem(x, SEVEN);
    let o: i32 = o.try_into().unwrap();
    let s: u8 = *scale.at(i);
    let s: i32 = s.into();
    base + 12 * (o - 10) + s
}

/// Degree `d` in chord `tok`'s colour (the source's `P` and `PB`).
#[inline(never)]
fn pt(base: i32, home: Span<u8>, d: i32, tok: u32) -> i32 {
    pitch(base, scale_of(home, tok), d)
}

fn snap(d: i32, c: i32) -> i32 {
    d + *SNAP.span().at(m7(d - c))
}

/// The root of the triad on `c`, placed in [lo, lo + 6].
fn triad_root(c: i32, lo: i32) -> i32 {
    let m: i32 = m7(c - lo).try_into().unwrap();
    lo + m
}

fn deg(tok: u32) -> i32 {
    (tok % 8).try_into().unwrap()
}

fn sev(tok: u32) -> bool {
    tok >= 128
}

#[inline(never)]
fn vel(v: i32) -> u8 {
    if v < 1 {
        1
    } else if v > 127 {
        127
    } else {
        v.try_into().unwrap()
    }
}

fn i(x: u32) -> i32 {
    x.try_into().unwrap()
}

/// Math.round(a / b) for a >= 0, b > 0.
fn round_div(a: u32, b: u32) -> u32 {
    (2 * a + b) / (2 * b)
}

/// `Track.block`: every note on at `t`, then every note off at `t + d`; pitches outside 0-127 are
/// dropped, the velocity held to 1-127, nothing when d <= 0.
#[inline(never)]
fn block(ref tw: TrackWriter, ch: u8, t: u32, d: i32, ps: Span<i32>, v: i32) {
    if d <= 0 {
        return;
    }
    let v = vel(v);
    let end = t + d.try_into().unwrap();
    for p in ps {
        let p = *p;
        if p >= 0 && p < 128 {
            tw.message(t, 0x90 + ch, p.try_into().unwrap(), v);
        }
    }
    for p in ps {
        let p = *p;
        if p >= 0 && p < 128 {
            tw.message(end, 0x80 + ch, p.try_into().unwrap(), 0);
        }
    }
}

/// `block` of one note.
#[inline(never)]
fn one(ref tw: TrackWriter, ch: u8, t: u32, d: i32, p: i32, v: i32) {
    block(ref tw, ch, t, d, [p].span(), v);
}

/// An event to sort: time, off (0) before on (1), then the order it was made in.
#[inline(never)]
fn ev_push(ref ev: Array<u64>, t: u32, on: bool, p: u32, v: u8) {
    let idx: u64 = ev.len().into();
    let flag: u64 = if on {
        1
    } else {
        0
    };
    let t: u64 = t.into();
    let p: u64 = p.into();
    let v: u64 = v.into();
    ev.append(((t * 2 + flag) * 1024 + idx) * 16384 + p * 128 + v);
}

/// Stable merge sort (the keys are unique).
fn sort(xs: Span<u64>) -> Span<u64> {
    let n = xs.len();
    if n < 2 {
        return xs;
    }
    let h = n / 2;
    let a = sort(xs.slice(0, h));
    let b = sort(xs.slice(h, n - h));
    let mut out: Array<u64> = array![];
    let (mut x, mut y) = (0, 0);
    while x < h || y < n - h {
        if y == n - h || (x < h && *a.at(x) < *b.at(y)) {
            out.append(*a.at(x));
            x += 1;
        } else {
            out.append(*b.at(y));
            y += 1;
        }
    }
    out.span()
}

/// The events sorted, written as note ons and offs on channel `ch`.
#[inline(never)]
fn ev_write(ref tw: TrackWriter, ch: u8, ev: Span<u64>) {
    for x in sort(ev) {
        let x = *x;
        let v: u8 = (x % 128).try_into().unwrap();
        let p: u8 = ((x / 128) % 128).try_into().unwrap();
        let key = x / 16384;
        let t: u32 = (key / 2048).try_into().unwrap();
        if (key / 1024) % 2 == 1 {
            tw.message(t, 0x90 + ch, p, v);
        } else {
            tw.message(t, 0x80 + ch, p, 0);
        }
    }
}

/// CC 7 as a mix level (loot_editions.js volOf).
fn vol_of(flags: u32, ch: u8, program: u32) -> u8 {
    let k: u32 = if (flags % 2 == 1 && ch == 3) || ((flags / 2) % 2 == 1 && ch == 2) {
        837
    } else if (ch == 0 || ch == 1) && program == 72 {
        725
    } else if (ch == 0 || ch == 1) && program == 62 {
        949
    } else if ch == 2 && program == 99 {
        837
    } else if ch == 4 && program == 33 {
        1072
    } else {
        1000
    };
    let v = *VOL.span().at(ch.into());
    ((v * k + 500) / 1000).try_into().unwrap()
}

/// A channel's track, opened with its program, volume, pan and reverb.
#[inline(never)]
fn channel_track(ch: u8, program: u32, flags: u32) -> TrackWriter {
    let mut tw = TrackWriterTrait::new();
    tw.message1(0, 0xC0 + ch, program.try_into().unwrap());
    tw.message(0, 0xB0 + ch, 7, vol_of(flags, ch, program));
    tw.message(0, 0xB0 + ch, 10, *PAN.span().at(ch.into()));
    tw.message(0, 0xB0 + ch, 91, 40);
    tw
}

#[inline(never)]
fn stream(fold: u32, e: u32, id: u32, a: u32, b: u32) -> Rng {
    RngTrait::new(fold ^ e.wrapping_mul(a) ^ id.wrapping_mul(b))
}

fn low32(x: felt252) -> u32 {
    let w: u256 = x.into();
    (w % 0x100000000).try_into().unwrap()
}

/// Byte `k` of a packed word (tokens).
fn byte(x: u32, k: u32) -> u32 {
    (x / *[1_u32, 0x100, 0x10000, 0x1000000].span().at(k)) % 256
}

// ── chords ──

/// A chord's substitute in an answering phrase (the source's `sub`): drawn when it has any.
#[inline(never)]
fn sub(home: u32, tok: u32, ref h: Rng) -> u32 {
    let subs = SUBS.span();
    let mut k = *SUBS_AT.span().at(home);
    let end = *SUBS_AT.span().at(home + 1);
    let t: u64 = tok.into();
    while k < end {
        let x = *subs.at(k);
        if x % 256 == t {
            let n: u32 = ((x / 256) % 8).try_into().unwrap();
            let j = h.int(n);
            let sh = *[0x800_u64, 0x80000, 0x8000000, 0x800000000].span().at(j);
            return ((x / sh) % 256).try_into().unwrap();
        }
        k += 1;
    }
    tok
}

fn maybe(home: u32, tok: u32, ref h: Rng) -> u32 {
    if h.int(2) == 1 {
        sub(home, tok, ref h)
    } else {
        tok
    }
}

/// A section's 8 chord tokens (loot_editions.js sectionNumerals).
#[inline(never)]
fn section_chords(s: Box<Style>, p: u32, closing: bool, ref h: Rng) -> Span<u32> {
    let s = s.unbox();
    let cads = if closing {
        s.cad_close
    } else {
        s.cad_open
    };
    let cad = *cads.at(h.int(cads.len()));
    let (c0, c1) = (cad % 256, cad / 256);
    let lo = *s.progs.at(2 * p);
    let hi = *s.progs.at(2 * p + 1);
    let (p0, p1, p2, p3) = (byte(lo, 0), byte(lo, 1), byte(lo, 2), byte(lo, 3));
    if hi != 0xffffffff {
        return [p0, p1, p2, p3, byte(hi, 0), byte(hi, 1), byte(hi, 2), byte(hi, 3)].span();
    }
    let home = s.home;
    if s.chord_bars == 1 {
        let m = maybe(home, p0, ref h);
        let x = sub(home, p1, ref h);
        [p0, p1, p2, p3, m, x, c0, c1].span()
    } else {
        let x = sub(home, p1, ref h);
        let m = maybe(home, p2, ref h);
        [p0, p0, p1, x, p2, m, c0, p3].span()
    }
}

// ── melody ──

#[derive(Copy, Drop)]
struct Note {
    t: u32,
    len: u32,
    d: i32,
}

#[derive(Copy, Drop)]
struct Mel {
    bar: u32,
    strong2: u32,
    lo: i32,
    motif: Span<i32>,
}

fn strong(t: u32, bar: u32, strong2: u32) -> bool {
    let pos = t % bar;
    pos == 0 || (strong2 > 0 && pos == strong2)
}

/// One bar of a melody from its rhythm `cell` (eighths, 4 bits each).
#[inline(never)]
fn melody_bar(
    m: Box<Mel>, ref out: Array<Note>, ref prev: i32, ref mi: u32, ref r: Rng, cell: u32, b: u32,
    ch: i32, full: bool,
) {
    let m = m.unbox();
    let (lo, motif) = (m.lo, m.motif);
    let hi = lo + 10;
    let mut cell = cell;
    let mut t = b * m.bar;
    let target = lo + *[3_i32, 5, 6, 5].span().at(b % 4);
    while cell != 0 {
        let len = (cell % 16) * 240;
        cell /= 16;
        let mut d = if mi < motif.len() {
            let mut d = *motif.at(mi);
            mi += 1;
            while d > hi {
                d -= 7;
            }
            while d < lo {
                d += 7;
            }
            d
        } else {
            let dir: i32 = if prev < target - 1 {
                1
            } else if prev > target + 1 {
                -1
            } else if r.int(2) == 1 {
                1
            } else {
                -1
            };
            let x = r.int(100);
            let step = if x < 12 {
                0
            } else if x < 66 {
                dir
            } else if x < 90 {
                2 * dir
            } else {
                -dir
            };
            let d = prev + step;
            if d > hi {
                hi
            } else if d < lo {
                lo
            } else {
                d
            }
        };
        if strong(t, m.bar, m.strong2) || len >= 720 {
            d = snap(d, ch);
        }
        if cell == 0 && b == 7 && full {
            d = if prev >= 4 {
                7
            } else {
                0
            };
        } else if cell == 0 && (b == 3 || b == 7) {
            d = if prev >= 1 {
                4
            } else {
                -3
            };
        }
        out.append(Note { t, len, d });
        prev = d;
        t += len;
    }
}

/// A section's melody over its chords (the source's `melody`).
#[inline(never)]
fn melody(
    cells: Span<u32>, ends: Span<u32>, m: Box<Mel>, chords: Span<u32>, full: bool, ref r: Rng,
) -> Span<Note> {
    let mm = m.unbox();
    let (bar, strong2, lo) = (mm.bar, mm.strong2, mm.lo);
    let idea0 = *cells.at(r.int(cells.len()));
    let idea1 = *cells.at(r.int(cells.len()));
    let c2 = *cells.at(r.int(cells.len()));
    let e3 = *ends.at(r.int(ends.len()));
    let c6 = *cells.at(r.int(cells.len()));
    let e7 = *ends.at(r.int(ends.len()));
    let mut out: Array<Note> = array![];
    let mut prev = lo + 3;
    let mut mi: u32 = 0;
    let plan = [idea0, idea1, c2, e3, 0, 0, c6, e7];
    for b in 0..8_u32 {
        let ch = deg(*chords.at(b));
        if b == 4 || b == 5 {
            let (from, to) = ((b - 4) * bar, (b - 3) * bar);
            let src = out.span();
            for n in src {
                let n = *n;
                if n.t >= from && to > n.t {
                    let t = n.t + 4 * bar;
                    let d = if strong(t, bar, strong2) {
                        snap(n.d, ch)
                    } else {
                        n.d
                    };
                    out.append(Note { t, len: n.len, d });
                    prev = d;
                }
            }
            continue;
        }
        melody_bar(m, ref out, ref prev, ref mi, ref r, *plan.span().at(b), b, ch, full);
    }
    out.span()
}

// ── spread chords ──

/// loot_editions.js spreadOf: 0 struck, 1-2 rolled up or down, 3-4 an arpeggio up or up and back.
fn spread_of(seed: u32, share: u32, lean: u32, kind: u32, bar: u32) -> u32 {
    let h = mix(seed, kind * 16 + bar);
    if h % 100 >= share {
        return 0;
    }
    let arp = lean == 1 || (lean == 2 && (h / 0x100) % 2 == 1);
    (if arp {
        3
    } else {
        1
    }) + if (h / 0x1000) % 3 == 0 {
        1
    } else {
        0
    }
}

/// loot_editions.js spreadStep.
fn spread_step(seed: u32, kind: u32, bar: u32, room: u32) -> u32 {
    let h = mix(seed ^ 0x53544550, kind * 16 + bar) / 16;
    if room < 120 {
        return 0;
    }
    if room < 240 {
        return if h % 10 == 0 {
            60
        } else {
            0
        };
    }
    if room < 480 {
        // eight sixteenths, one thirty-second
        return if h % 9 < 8 {
            120
        } else {
            60
        };
    }
    let k = h % 17;
    if k < 8 {
        240
    } else if k < 16 {
        120
    } else {
        60
    }
}

/// The pitches in 0-127, sorted and without repeats.
#[inline(never)]
fn sorted_unique(ps: Span<i32>) -> Span<u32> {
    let mut out: Array<u32> = array![];
    let mut last: i32 = -1;
    loop {
        let mut best: i32 = 128;
        for p in ps {
            let p = *p;
            if p > last && p < best {
                best = p;
            }
        }
        if best == 128 {
            break;
        }
        out.append(best.try_into().unwrap());
        last = best;
    }
    out.span()
}

/// loot_editions.js spreadChord, its notes pushed as sortable events (on, then off, each note).
#[inline(never)]
fn spread_chord(
    ref ev: Array<u64>, how: u32, t: u32, d: u32, room: u32, ps: Span<i32>, v: i32, step: u32,
) {
    let ps = sorted_unique(ps);
    let np = ps.len();
    if how == 0 || np < 2 || d < 100 {
        for p in ps {
            ev_push(ref ev, t, true, *p, vel(v));
            ev_push(ref ev, t + d, false, *p, 0);
        }
        return;
    }
    let n = if step == 0 {
        0
    } else {
        let a = room / step;
        let b = if d >= 480 {
            let x = (d + 40) / step;
            if x < 2 {
                2
            } else {
                x
            }
        } else {
            np
        };
        if a < b {
            a
        } else {
            b
        }
    };
    if how >= 3 && n >= 2 {
        let cyc = if how == 4 && np > 2 {
            2 * np - 2
        } else {
            np
        };
        for k in 0..n {
            let at = k % cyc;
            let p = *ps.at(if at < np {
                at
            } else {
                2 * np - 2 - at
            });
            let len = if k == n - 1 && d > k * step + step - 20 {
                d - k * step
            } else {
                step - 20
            };
            let nt = t + k * step;
            ev_push(ref ev, nt, true, p, vel(if k == 0 {
                v
            } else {
                v - 6
            }));
            ev_push(ref ev, nt + len, false, p, 0);
        }
        return;
    }
    let g = d / (2 * np);
    let top = if d >= 400 {
        40
    } else {
        20
    };
    let gap = if g < top {
        g
    } else {
        top
    };
    let down = how == 2 || how == 4;
    for k in 0..np {
        let p = *ps.at(if down {
            np - 1 - k
        } else {
            k
        });
        let nt = t + k * gap;
        ev_push(ref ev, nt, true, p, vel(if k == np - 1 {
            v + 4
        } else {
            v - 4
        }));
        ev_push(ref ev, nt + d - k * gap, false, p, 0);
    }
}

// ── the purchase ──

/// What the part writers read, boxed.
#[derive(Copy, Drop)]
struct Ctx {
    s: Box<Style>,
    base: i32,
    home: Span<u8>,
    bar: u32,
    rot: u32,
    parts: u32,
    acc_down: bool,
    detached: bool,
    accomp: Span<u32>,
    bass: Span<u32>,
    perc: Span<u32>,
    bass_mode: u32,
    orn: u32,
    orn_seed: u32,
    orn_kind: u32,
    mega: bool,
    alt_kind: u32,
    intro_ticks: u32,
    spread_share: u32,
    spread_lean: u32,
    spread_seed: u32,
}

#[derive(Drop)]
struct Writers {
    lead: TrackWriter,
    alt: TrackWriter,
    mega: TrackWriter,
    descant: TrackWriter,
    accomp: TrackWriter,
    bass: TrackWriter,
    pad: TrackWriter,
    perc: TrackWriter,
}

/// The intro's draws (loot_editions.js, stream IN).
#[derive(Copy, Drop)]
struct Intro {
    bars: u32,
    up: bool,
    answer: i32,
    mirror: bool,
    counter: bool,
    run: bool,
    arp: bool,
}

fn gap_of(detached: bool, len: u32) -> u32 {
    if detached && len <= 240 {
        len / 2
    } else {
        20
    }
}

/// The accompaniment's three voices on chord `tok` (root, then the week's inversion).
fn voicing(c: @Ctx, tok: u32, lo: i32) -> (i32, i32, i32, i32) {
    let r = triad_root(deg(tok), lo);
    let rot = c.rot;
    let (base, home) = (c.base, c.home);
    (
        r,
        pt(base, home, r + *ROT.span().at(rot), tok),
        pt(base, home, r + *ROT.span().at(rot + 1), tok),
        pt(base, home, r + *ROT.span().at(rot + 2), tok),
    )
}

/// The intro before the first tune (loot_editions.js, `introBars`).
#[inline(never)]
fn intro(ref w: Writers, k: Box<Ctx>, it: Intro, mel_a: Span<Note>) {
    let c = k.unbox();
    let s = c.s.unbox();
    let n_bars = it.bars;
    let (base, home, bar) = (c.base, c.home, c.bar);
    let bass_base = base - 24;
    let plan = *INTRO_PLAN.span().at(s.home);
    let sub_t: u32 = 120;
    let first = (*mel_a.at(0)).d;
    let half = bar / 2;
    let run_len = half / sub_t;
    let dir: i32 = if it.up {
        1
    } else {
        -1
    };
    let mut call: Array<Note> = array![];
    for n in mel_a {
        if n.t + n.len <= half {
            call.append(*n);
        }
    }
    if call.len() == 0 {
        call.append(Note { t: 0, len: half, d: first });
    }
    let call = call.span();
    let low: i32 = if c.acc_down {
        -12
    } else {
        0
    };
    for kb in 0..n_bars {
        let t = kb * bar;
        let tok = byte(plan, 4 - n_bars + kb);
        let ch = deg(tok);
        let last = kb == n_bars - 1;
        let swell: i32 = i(round_div(14 * (kb + 1), n_bars));
        let seq: i32 = i(kb) - i(n_bars - 1);
        let groove = n_bars >= 3 && kb == 0;
        if c.parts & PAD != 0 {
            let r = triad_root(ch, -7);
            let mut ps = array![
                pt(base, home, r, tok), pt(base, home, r + 2, tok), pt(base, home, r + 4, tok),
            ];
            if sev(tok) {
                ps.append(pt(base, home, r + 6, tok));
            }
            block(ref w.pad, 4, t, i(bar) - 40, ps.span(), 34 + swell);
        }
        if c.parts & BASS != 0 {
            if it.counter && !groove && call.len() > 1 {
                for n in call {
                    let n = *n;
                    one(
                        ref w.bass,
                        3,
                        t + n.t,
                        i(n.len) - 20,
                        pt(bass_base, home, ch - (n.d - first), tok),
                        70 + swell,
                    );
                }
                one(ref w.bass, 3, t + half, i(half) - 30, pt(bass_base, home, ch, tok), 68 + swell);
            } else {
                one(ref w.bass, 3, t, i(bar) - 30, pt(bass_base, home, ch, tok), 68 + swell);
            }
        }
        let (v0, p0, p1, p2) = voicing(@c, tok, -3);
        if last && it.arp {
            let steps = [0_i32, 2, 4, 7, 9, 11, 14];
            let count = bar / sub_t;
            for x in 0..count {
                let up = if 2 * x < count {
                    x
                } else {
                    count - 1 - x
                };
                one(
                    ref w.accomp,
                    2,
                    t + x * sub_t,
                    i(sub_t) - 10,
                    pt(base, home, v0 + *steps.span().at(up % 7), tok) + low,
                    36 + i(round_div(16 * x, count)),
                );
            }
        } else if groove {
            let mut ev: Array<u64> = array![];
            let acc = c.accomp;
            let na = acc.len();
            for j in 0..na {
                let x = *acc.at(j);
                let (off, d, voice) = (x % 2048, (x / 2048) % 2048, (x / 0x400000) % 16);
                let dv: i32 = i(x / 0x4000000) - 32;
                let ps = if voice == 9 {
                    array![p0, p1, p2]
                } else if voice == 10 {
                    array![p0, p0 + 12]
                } else if voice == 3 {
                    array![p0 + 12]
                } else if voice == 0 {
                    array![p0]
                } else if voice == 1 {
                    array![p1]
                } else {
                    array![p2]
                };
                let next = if j + 1 < na {
                    *acc.at(j + 1) % 2048
                } else {
                    bar
                };
                let room = next - off;
                let m = if d < room {
                    d
                } else {
                    room
                };
                let len = if m < 40 {
                    30
                } else {
                    m - 10
                };
                let v = vel(50 + swell + dv);
                for p in ps {
                    let p: u32 = (p + low).try_into().unwrap();
                    ev_push(ref ev, t + off, true, p, v);
                    ev_push(ref ev, t + off + len, false, p, 0);
                }
            }
            ev_write(ref w.accomp, 2, ev.span());
        } else {
            for n in call {
                let n = *n;
                let dd = if it.mirror {
                    first - (n.d - first)
                } else {
                    n.d
                };
                one(
                    ref w.accomp,
                    2,
                    t + half + n.t,
                    i(n.len - gap_of(c.detached, n.len)),
                    pt(base, home, dd + seq + it.answer, tok),
                    62 + swell,
                );
            }
        }
        if !groove {
            for n in call {
                let n = *n;
                one(
                    ref w.lead,
                    0,
                    t + n.t,
                    i(n.len - gap_of(c.detached, n.len)),
                    pt(base, home, n.d + seq, tok),
                    70 + swell,
                );
            }
        }
        if last && it.run {
            for x in 0..run_len {
                one(
                    ref w.lead,
                    0,
                    t + half + x * sub_t,
                    i(sub_t) - 15,
                    pt(base, home, first - i(run_len - x) * dir, tok),
                    44 + i(round_div(14 * x, run_len)),
                );
            }
        }
        if c.parts & PERC != 0 {
            if n_bars > 1 {
                let (nb, step) = if s.den == 8 {
                    (2, 720)
                } else {
                    (s.num, 480)
                };
                for j in 0..nb {
                    let off = j * step;
                    if !last || off < half {
                        one(ref w.perc, 9, t + off, 100, 42, 34 + swell / 2);
                    }
                }
            }
            if last {
                for x in 0..run_len {
                    let f = (x * 8) / run_len;
                    let f = if f > 7 {
                        7
                    } else {
                        f
                    };
                    one(
                        ref w.perc,
                        9,
                        t + half + x * sub_t,
                        100,
                        i(*DRUM_FILL.span().at(f)),
                        28 + i(round_div(16 * x, run_len)),
                    );
                }
            }
        }
    }
}

/// A tune's lead notes (and their mega double and descant) from tick `t0`.
#[inline(never)]
fn lead_section(
    ref w: Writers,
    k: Box<Ctx>,
    m: Span<Note>,
    chords: Span<u32>,
    t0: u32,
    kind: u32,
    doubled: i32,
    plain: bool,
) {
    let c = k.unbox();
    let (base, home, bar) = (c.base, c.home, c.bar);
    let alt = kind == c.alt_kind;
    for n in m {
        let n = *n;
        let t = t0 + n.t;
        let len: i32 = i(n.len - gap_of(c.detached, n.len));
        let tok = *chords.at(n.t / bar);
        let d70: u32 = (n.d + 70).try_into().unwrap();
        let grace = c.orn > 0
            && n.len >= 480
            && (((t - c.intro_ticks) / 240) * 7 + d70 * 13 + c.orn_seed) % 100 < c.orn;
        let v: i32 = if n.t % bar != 0 {
            90
        } else {
            100
        };
        let main = pt(base, home, n.d, tok);
        // the lead (or the second lead), then the mega double an octave up
        let mut voice: u32 = 0;
        while voice < 2 {
            let (ch, up, vv) = if voice == 1 {
                (5_u8, 12_i32, 70_i32)
            } else if alt {
                (ALT_CHANNEL, 0, v)
            } else {
                (0, 0, v)
            };
            if grace && c.orn_kind == 3 {
                let upper = pt(base, home, n.d + 1, tok);
                if voice == 1 {
                    one(ref w.mega, ch, t, 60, main + up, vv);
                    one(ref w.mega, ch, t + 60, 60, upper + up, vv - 10);
                    one(ref w.mega, ch, t + 120, len - 120, main + up, vv);
                } else if alt {
                    one(ref w.alt, ch, t, 60, main + up, vv);
                    one(ref w.alt, ch, t + 60, 60, upper + up, vv - 10);
                    one(ref w.alt, ch, t + 120, len - 120, main + up, vv);
                } else {
                    one(ref w.lead, ch, t, 60, main + up, vv);
                    one(ref w.lead, ch, t + 60, 60, upper + up, vv - 10);
                    one(ref w.lead, ch, t + 120, len - 120, main + up, vv);
                }
            } else if grace {
                let g = pt(base, home, n.d + *[1_i32, -1, -2].span().at(c.orn_kind), tok);
                if voice == 1 {
                    one(ref w.mega, ch, t, 80, g + up, vv - 10);
                    one(ref w.mega, ch, t + 80, len - 80, main + up, vv);
                } else if alt {
                    one(ref w.alt, ch, t, 80, g + up, vv - 10);
                    one(ref w.alt, ch, t + 80, len - 80, main + up, vv);
                } else {
                    one(ref w.lead, ch, t, 80, g + up, vv - 10);
                    one(ref w.lead, ch, t + 80, len - 80, main + up, vv);
                }
            } else if voice == 1 {
                one(ref w.mega, ch, t, len, main + up, vv);
            } else if alt {
                one(ref w.alt, ch, t, len, main + up, vv);
            } else {
                one(ref w.lead, ch, t, len, main + up, vv);
            }
            voice += if c.mega {
                1
            } else {
                2
            };
        }
        if doubled != 0 {
            one(ref w.descant, 1, t, len, pt(base, home, n.d + doubled, tok), 70);
        } else if n.len >= 480 && c.parts & DESCANT != 0 && !plain {
            one(ref w.descant, 1, t, len, pt(base, home, n.d + 2, tok), 64);
        }
    }
}

/// One bar of the accompaniment (loot_editions.js: the spread chords, sorted).
#[inline(never)]
fn accomp_bar(ref tw: TrackWriter, k: Box<Ctx>, tok: u32, kind: u32, b: u32, t: u32, ref fast: u32) {
    let c = k.unbox();
    let (base, home, bar) = (c.base, c.home, c.bar);
    let (v0, p0, p1, p2) = voicing(@c, tok, -3);
    let how = spread_of(
        c.spread_seed, *[20_u32, 35, 50].span().at(c.spread_share), c.spread_lean, kind, b,
    );
    let low: i32 = if c.acc_down {
        12
    } else {
        0
    };
    let mut ev: Array<u64> = array![];
    let acc = c.accomp;
    let na = acc.len();
    let key = kind * 16 + b;
    for j in 0..na {
        let x = *acc.at(j);
        let (off, d, voice) = (x % 2048, (x / 2048) % 2048, (x / 0x400000) % 16);
        let dv: i32 = i(x / 0x4000000) - 32;
        let ps = if voice == 9 {
            if sev(tok) {
                array![p0 - low, p1 - low, p2 - low, pt(base, home, v0 + 6, tok) - low]
            } else {
                array![p0 - low, p1 - low, p2 - low]
            }
        } else if voice == 10 {
            array![p0 - low, p0 + 12 - low]
        } else if voice == 3 {
            array![p0 + 12 - low]
        } else if voice == 0 {
            array![p0 - low]
        } else if voice == 1 {
            array![p1 - low]
        } else {
            array![p2 - low]
        };
        let next = if j + 1 < na {
            *acc.at(j + 1) % 2048
        } else {
            bar
        };
        let room = next - off;
        let mut step = if how >= 3 && voice >= 9 {
            spread_step(c.spread_seed, kind, b, room)
        } else {
            0
        };
        // thirty-seconds in one bar of one tune at most
        if step == 60 && fast != key {
            if (c.spread_seed / 0x100000) % 4 == 0 && fast == NO_FAST {
                fast = key;
            } else {
                step = if room >= 240 {
                    120
                } else {
                    0
                };
            }
        }
        let h = if voice >= 9 {
            how
        } else {
            0
        };
        spread_chord(ref ev, h, t + off, d, room, ps.span(), 72 + dv, step);
    }
    ev_write(ref tw, 2, ev.span());
}

/// A walking line (WALKS[raw + 6]) for bar `b` of a tune whose root moves by `raw` steps.
fn walk_line(raw: i32, seed: u32, b: u32) -> Span<i32> {
    let v = *WALKS.span().at((raw + 6).try_into().unwrap());
    let n = if v >= 0x10000 {
        2
    } else {
        1
    };
    let mut x = if mix(seed, b) % n == 0 {
        v % 0x10000
    } else {
        v / 0x10000
    };
    let mut out: Array<i32> = array![];
    for _ in 0..4_u32 {
        out.append(i(x % 16) - 8);
        x /= 16;
    }
    out.span()
}

/// The source's `put`: bar `pb`'s notes at offsets `offs` above its root, lengths `durs`.
#[inline(never)]
fn walk_put(
    ref tw: TrackWriter, k: Box<Ctx>, chords: Span<u32>, t0: u32, pb: u32, offs: Span<i32>,
    durs: Span<u32>,
) {
    let c = k.unbox();
    let tok = *chords.at(pb);
    let r = deg(tok);
    let mut t = t0 + pb * c.bar;
    let mut beat: u32 = 0;
    while beat < offs.len() {
        let len = *durs.at(beat);
        let cut = if c.bass_mode == 2 {
            len / 4
        } else {
            30
        };
        let v = if beat == 0 {
            98
        } else {
            88
        };
        one(ref tw, 3, t, i(len - cut), pt(c.base - 24, c.home, r + *offs.at(beat), tok), v);
        t += len;
        beat += 1;
    }
}

/// A tune's walking bass (loot_editions.js walkBass), written from tick `t0`; `next` is the next
/// tune's first root (none at the end).
#[inline(never)]
fn walk_section(
    ref tw: TrackWriter, k: Box<Ctx>, chords: Span<u32>, next: Option<i32>, t0: u32, seed: u32,
) {
    let c = k.unbox();
    let s = c.s.unbox();
    let (num, den) = (s.num, s.den);
    let mut b: u32 = 0;
    while b < 8 {
        let root = deg(*chords.at(b));
        let to = if b + 1 < 8 {
            Option::Some(deg(*chords.at(b + 1)))
        } else {
            next
        };
        match to {
            Option::None => { walk_put(ref tw, k, chords, t0, b, [0].span(), [c.bar].span()); },
            Option::Some(to) => {
                if num == 2 && den == 4 {
                    let to2 = if b + 2 < 8 {
                        Option::Some(deg(*chords.at(b + 2)))
                    } else {
                        next
                    };
                    let pair = b % 2 == 0 && b + 1 < 8 && deg(*chords.at(b + 1)) == root;
                    if pair && to2.is_some() {
                        let w = walk_line(to2.unwrap() - root, seed, b);
                        walk_put(ref tw, k, chords, t0, b, w.slice(0, 2), [480, 480].span());
                        walk_put(ref tw, k, chords, t0, b + 1, w.slice(2, 2), [480, 480].span());
                        b += 1;
                    } else {
                        let w = walk_line(to - root, seed, b);
                        walk_put(
                            ref tw, k, chords, t0, b, [*w.at(0), *w.at(3)].span(), [480, 480].span(),
                        );
                    }
                } else if den == 8 {
                    let w = walk_line(to - root, seed, b);
                    walk_put(ref tw, k, chords, t0, b, w, [480, 240, 480, 240].span());
                } else if num == 3 {
                    let w = walk_line(to - root, seed, b);
                    walk_put(
                        ref tw, k, chords, t0, b, [*w.at(0), *w.at(2), *w.at(3)].span(),
                        [480, 480, 480].span(),
                    );
                } else {
                    let w = walk_line(to - root, seed, b);
                    walk_put(ref tw, k, chords, t0, b, w, [480, 480, 480, 480].span());
                }
            },
        }
        b += 1;
    }
}

/// One bar of the bass figure, the pad and the drums.
#[inline(never)]
fn rhythm_bar(ref w: Writers, k: Box<Ctx>, tok: u32, b: u32, t: u32, walking: bool, ending: u32) {
    let c = k.unbox();
    let (base, home, bar) = (c.base, c.home, c.bar);
    let ch = deg(tok);
    if c.parts & BASS != 0 && !walking {
        let bass_base = base - 24;
        for x in c.bass {
            let x = *x;
            let (off, d, tone) = (x % 2048, (x / 2048) % 2048, (x / 0x400000) % 16);
            let dv: i32 = i(x / 0x4000000) - 32;
            let ps = if tone == 4 {
                array![pitch(bass_base, home, 0), pitch(bass_base, home, 4)]
            } else {
                array![pt(bass_base, home, ch + *[0_i32, -3, 4, 7].span().at(tone), tok)]
            };
            if c.bass_mode == 1 {
                block(ref w.bass, 3, t + off, i(d / 2) - 10, ps.span(), 96 + dv);
                block(ref w.bass, 3, t + off + d / 2, i(d / 2) - 10, ps.span(), 96 + dv);
            } else {
                let len = if c.bass_mode == 2 {
                    d / 2
                } else {
                    d
                };
                block(ref w.bass, 3, t + off, i(len), ps.span(), 96 + dv);
            }
        }
    }
    if c.parts & PAD != 0 && b % 2 == 0 {
        let r = triad_root(ch, -7);
        let mut ps = array![
            pt(base, home, r, tok), pt(base, home, r + 2, tok), pt(base, home, r + 4, tok),
        ];
        if sev(tok) {
            ps.append(pt(base, home, r + 6, tok));
        }
        block(ref w.pad, 4, t, i(2 * bar) - 40, ps.span(), 46);
    }
    if c.parts & PERC != 0 {
        let half = bar / 2;
        if ending != 2 {
            for x in c.perc {
                let x = *x;
                let off = x % 2048;
                if ending == 0 || off < half {
                    let note: i32 = i((x / 2048) % 128);
                    one(ref w.perc, 9, t + off, 120, note, 100 + i(x / 0x40000) - 64);
                }
            }
        }
        if ending == 1 {
            let count = half / 120;
            for x in 0..count {
                let f = (x * 8) / count;
                let f = if f > 7 {
                    7
                } else {
                    f
                };
                one(
                    ref w.perc,
                    9,
                    t + half + x * 120,
                    100,
                    i(*DRUM_FILL.span().at(f)),
                    58 + i(round_div(26 * x, count)),
                );
            }
        }
    }
}

/// Edition `e`'s style index, its tables and its tempo (e >= 1).
#[inline(never)]
pub fn edition_genome(e: u32) -> (u32, Box<Style>, u32) {
    assert(e >= 1, 'editions start at 1');
    let st = (e - 1) % STYLE_COUNT;
    let sb = style(st);
    let s = sb.unbox();
    let pass = (e - 1) / STYLE_COUNT;
    let bpm = s.bpm_lo + (pass * 7 + st * 3) % (s.bpm_hi - s.bpm_lo + 1);
    (st, sb, bpm)
}

fn kind_of(form: u32, sec: u32) -> u32 {
    (form / *[1_u32, 4, 16, 64].span().at(sec)) % 4
}

/// The track bodies of edition `e` for Loot Beast `species` (species.cairo ids), mega or not, a
/// purchase seed and an optional day of drift: the tempo track, the lead, the descant, the
/// accompaniment, the bass, pad and percussion when they play, the mega double, the glissando and
/// the second lead, as loot_editions.js editionTrack.
pub fn edition_tracks(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>,
) -> Array<Array<u8>> {
    let (month, rotate, knob, delta, day) = match drift {
        Option::Some(d) => (
            match d.rhythm {
                Option::Some(h) => Option::Some(low32(h)),
                Option::None => Option::None,
            },
            match d.rotate {
                Option::Some(h) => Option::Some(low32(h)),
                Option::None => Option::None,
            },
            d.day_knob,
            d.delta_bpm,
            d.day,
        ),
        Option::None => (Option::None, Option::None, 6, 0, 0),
    };
    let sp = loot_species(species);
    let (_, sb, g_bpm) = edition_genome(e);
    let s = sb.unbox();
    let id = species;
    let ty: u32 = sp.beast_type.into();
    let fold = fold64(seed);
    let mut r = stream(fold, e, id, 0x9e3779b1, 0x85ebca77);
    let tonic_pc: u32 = sp.tonic_pc.into();
    let mut tonic = (tonic_pc + *[0_u32, 0, 0, 5, 7, 10, 2, 3].span().at(r.int(8))) % 12;
    let quicker = if s.bpm_hi <= SLOW_TOP {
        let mut tp = stream(fold, e, id, 0x5bd1e995, 0x1b56c4e9);
        *QUICKER.span().at(tp.int(9))
    } else {
        0
    };
    let b0 = g_bpm + *[0_u32, 2, 4, 4, 6, 8].span().at(r.int(6)) - 4;
    let bpm = (b0 * (100 + quicker) + 50) / 100;
    let np: u32 = 64;
    let mut pa = r.int(np);
    let mut pb = r.int(np);
    if pb == pa {
        pb = (pa + 1) % np;
    }
    let mut pc = (pa + 1 + r.int(np - 2)) % np;
    if pc == pb {
        pc = (pc + 1) % np;
    }
    if knob == 0 {
        let x = pa;
        pa = pb;
        pb = x;
    }
    r.int(s.n_modes);
    let mut form_id = r.int(8);
    let acc_i = r.int(4);
    let bass = *s.basses.at(r.int(3));
    let perc_i = r.int(2);
    let (acc_i, perc_i) = match month {
        Option::Some(m) => ((acc_i + 1 + m % 3) % 4, (perc_i + 1) % 2),
        Option::None => (acc_i, perc_i),
    };
    let accomp = *s.accomps.at(acc_i);
    let perc = *s.percs.at(perc_i);
    if let Option::Some(m) = month {
        form_id = (form_id + 1 + (m / 64) % 3) % 8;
        let km = (m / 256) % 3;
        if km < 2 {
            tonic = (tonic + *[7_u32, 5].span().at(km)) % 12;
        }
    }
    let form = *FORMS.span().at(form_id);
    let theme = r.int(4);
    let mut orn = *[0_u32, 0, 15, 30].span().at(r.int(4));
    let orn_seed = r.int(100);
    let detached = (r.int(2) == 1) != (knob >= 2 && knob <= 5);
    let mut orn_kind = orn_seed % 4;
    let roll = r.int(100);
    let mut bass_mode = roll % 3;
    let mut count = if roll < 20 {
        1
    } else if roll < 60 {
        2
    } else if roll < 88 {
        3
    } else {
        4
    };
    if sp.tier <= 2 && count < 4 {
        count += 1;
    }
    // the parts' order: a shuffle of descant, bass, pad, percussion (bits)
    let (mut order, mut x): (Array<u32>, u32) = opaque((array![DESCANT, BASS, PAD, PERC], 3));
    while x > 0 {
        let j = r.int(x + 1);
        let o = order.span();
        let mut next: Array<u32> = array![];
        for y in 0..4_u32 {
            next
                .append(
                    *o
                        .at(
                            if y == x {
                                j
                            } else if y == j {
                                x
                            } else {
                                y
                            },
                        ),
                );
        }
        order = next;
        x -= 1;
    }
    let order = order.span();
    let mut parts: u32 = opaque(0);
    for y in order.slice(0, count) {
        parts += *y;
    }
    let mut rot: u32 = 0;
    if let Option::Some(h) = rotate {
        if count == 4 {
            parts -= *order.at(h % 4);
        } else {
            parts = parts - *order.at(h % count) + *order.at(count + (h / 4) % (4 - count));
        }
        rot = 1 + (h / 16) % 2;
        orn_kind = (orn_kind + 1 + (h / 32) % 3) % 4;
        let dd: u32 = (day / 180).try_into().unwrap_or(1000);
        let ceiling = if 2 + dd < 4 {
            2 + dd
        } else {
            4
        };
        orn = *[0_u32, 15, 30, 45, 60].span().at((h / 128) % (ceiling + 1));
        bass_mode = (bass_mode + 1 + (h / 512) % 2) % 3;
    }
    // the walking bass (stream WK)
    let mut wk = stream(fold, e, id, 0x51ed270b, 0x2f0b4a13);
    let mut walking = wk.int(5) < 3;
    let walk_seed = wk.next();
    let mut walk_span = wk.int(4);
    if let Option::Some(h) = rotate {
        if (h / 16384) % 4 == 0 {
            walking = !walking;
        }
        walk_span = (walk_span + (h / 65536) % 4) % 4;
    }
    let bar = s.num * (1920 / s.den);
    let strong2 = if s.den == 8 {
        720
    } else if s.num == 4 {
        960
    } else {
        0
    };
    let base: i32 = if tonic < 6 {
        i(60 + tonic)
    } else {
        i(48 + tonic)
    };
    let home = (*SCALES.span().at(s.mode)).span();
    // the palette: lead, counter, accompaniment, bass, pad for this beast type
    let pal = s.palette;
    let mut lead_p = *pal.at(ty);
    if mega {
        lead_p = *MEGA_LEADS.span().at(id % 2);
    }
    if !mega && lead_p == 47 && (orn_seed + roll) % 4 != 0 {
        lead_p = *pal.at(3 + ty);
    }
    let acc_p = *pal.at(6 + ty);
    let mut acc_down = acc_p == 99 && (orn_seed / 8) % 3 == 0;
    // the theme as the A tune opens with it
    let mut motif: Array<i32> = array![];
    for y in 0..6_u32 {
        let d: i32 = (*sp.degrees.span().at(if theme == 2 {
            5 - y
        } else {
            y
        }))
            .into();
        motif.append(if theme == 1 {
            -d
        } else if theme == 3 {
            d + 2
        } else {
            d
        });
    }
    let mut mr = match month {
        Option::Some(m) => RngTrait::new(m),
        Option::None => r,
    };
    let kinds = [kind_of(form, 0), kind_of(form, 1), kind_of(form, 2), kind_of(form, 3)].span();
    let last_kind = *kinds.at(3);
    let has = |kk: u32| -> bool {
        *kinds.at(0) == kk || *kinds.at(1) == kk || *kinds.at(2) == kk || *kinds.at(3) == kk
    };
    // the second lead (stream AL)
    let mut al = stream(fold, e, id, 0x7ed55d16, 0x165667c5);
    let alt_draw = al.int(5) < 2;
    let alt_c = al.int(2) == 0;
    let alt_kind = if !alt_draw {
        NO_KIND
    } else if has(2) && alt_c {
        2
    } else if has(1) {
        1
    } else {
        NO_KIND
    };
    // the doubled repeats (stream DB) and the plain first passes
    let mut db = stream(fold, e, id, 0x3c6ef372, 0x1b873593);
    let mut doubled: Array<i32> = array![0];
    let mut any_doubled = false;
    for y in 1..4_u32 {
        let dv = if *kinds.at(y) == *kinds.at(y - 1) && (db.int(2) == 0 || db.int(5) < 3) {
            any_doubled = true;
            *[2_i32, -3, -4].span().at(db.int(3))
        } else {
            0
        };
        doubled.append(dv);
    }
    let doubled = doubled.span();
    // the tunes' chords (stream H)
    let mut hh = stream(fold, e, id, 0x27d4eb2d, 0x165667b1);
    let p_of = [pa, pb, pc, pa].span();
    let mut nums: Array<Span<u32>> = array![];
    for kk in 0..4_u32 {
        nums.append(section_chords(sb, *p_of.at(kk), kk != 1 || last_kind == 1, ref hh));
    }
    let nums = nums.span();
    // the spread chords (stream SP)
    let mut spr = stream(fold, e, id, 0x2545f491, 0x61c88647);
    let mut spread_share = spr.int(3);
    let mut spread_lean = spr.int(3);
    let mut spread_seed = spr.next();
    if let Option::Some(m) = month {
        spread_seed = mix(spread_seed, m);
    }
    if let Option::Some(h) = rotate {
        spread_share = (spread_share + 1 + (h / 2048) % 2) % 3;
        spread_lean = (spread_lean + 1 + (h / 4096) % 2) % 3;
    }
    let mut acc_low = spr.int(3) == 0;
    if let Option::Some(h) = rotate {
        if (h / 8192) % 2 == 1 {
            acc_low = !acc_low;
        }
    }
    if (s.flags / 4) % 2 == 0 {
        acc_low = false;
    }
    if acc_low {
        acc_down = true;
    }
    // the glissando (stream GL)
    let mut gl = stream(fold, e, id, 0x7feb352d, 0x846ca68b);
    let gl_draw = gl.int(20);
    let mut gl_seed = gl.next();
    if let Option::Some(h) = rotate {
        gl_seed = mix(gl_seed, h);
    }
    let gl_plan: Option<GlissPlan> = gliss_plan(gl_draw, gl_seed, [3, 3, 1, 0, 2].span());
    // the melodies
    let ma = BoxTrait::new(Mel { bar, strong2, lo: -1, motif: motif.span() });
    let mb = BoxTrait::new(Mel { bar, strong2, lo: 1, motif: [].span() });
    let mel_a = melody(s.cells, s.end, ma, *nums.at(0), true, ref mr);
    let mel_b = melody(s.cells, s.end, mb, *nums.at(1), last_kind == 1, ref mr);
    let mel_c = if form_id % 4 == 3 {
        melody(s.cells, s.end, mb, *nums.at(2), true, ref mr)
    } else {
        [].span()
    };
    let mut mel_d: Array<Note> = array![];
    if form_id >= 4 {
        let half = 4 * bar;
        if (orn_seed / 4) % 2 == 0 {
            let fresh = melody(s.cells, s.end, ma, *nums.at(0), true, ref mr);
            for n in mel_a {
                let n = *n;
                if half > n.t {
                    mel_d.append(n);
                }
            }
            for n in fresh {
                let n = *n;
                if n.t >= half {
                    mel_d.append(n);
                }
            }
        } else {
            let mut y: u32 = 0;
            while y < mel_a.len() {
                let n = *mel_a.at(y);
                if n.len < 480 || y + 1 == mel_a.len() {
                    mel_d.append(n);
                } else {
                    let nd = (*mel_a.at(y + 1)).d;
                    let h = n.len / 2;
                    mel_d.append(Note { t: n.t, len: h, d: n.d });
                    mel_d
                        .append(
                            Note {
                                t: n.t + h,
                                len: n.len - h,
                                d: if nd < n.d {
                                    n.d - 1
                                } else {
                                    n.d + 1
                                },
                            },
                        );
                }
                y += 1;
            }
        }
    }
    let mel_d = mel_d.span();
    // the drums' tune endings (stream DF)
    let mut df = stream(fold, e, id, 0x2c1b3c6d, 0x297a2d39);
    let mut drum_ends: Array<u32> = array![];
    for _ in 0..4_u32 {
        let x = df.int(20);
        drum_ends.append(if x < 7 {
            1
        } else if x < 12 {
            2
        } else {
            0
        });
    }
    let drum_ends = drum_ends.span();
    // the intro (stream IN)
    let mut inr = stream(fold, e, id, 0x6a09e667, 0x3c6ef35f);
    let mut intro_bars = if inr.int(2) == 0 {
        1 + inr.int(4)
    } else {
        0
    };
    let in_kind = inr.int(4);
    let in_up = inr.int(3) > 0;
    let in_answer = *[-3_i32, 2, -5].span().at(inr.int(3));
    let in_mirror = inr.int(2) == 0;
    let in_counter = inr.int(3) > 0;
    let in_run = inr.int(4) == 0;
    let in_arp = in_kind == 3 && inr.int(2) == 0;
    if intro_bars == 1 && s.num == 2 {
        intro_bars = 2;
    }
    let intro_ticks = intro_bars * bar;
    let ctx = BoxTrait::new(
        Ctx {
            s: sb,
            base,
            home,
            bar,
            rot,
            parts,
            acc_down,
            detached,
            accomp,
            bass,
            perc,
            bass_mode,
            orn,
            orn_seed,
            orn_kind,
            mega,
            alt_kind,
            intro_ticks,
            spread_share,
            spread_lean,
            spread_seed,
        },
    );
    let flags = s.flags;
    let mut w = Writers {
        lead: channel_track(0, lead_p, flags),
        alt: channel_track(ALT_CHANNEL, acc_p, flags),
        mega: channel_track(5, *MEGA_LEADS.span().at((id + 1) % 2), flags),
        descant: channel_track(1, lead_p, flags),
        accomp: channel_track(2, acc_p, flags),
        bass: channel_track(3, *pal.at(9 + ty), flags),
        pad: channel_track(4, *pal.at(12 + ty), flags),
        perc: channel_track(9, 0, flags),
    };
    if intro_bars > 0 {
        intro(
            ref w,
            ctx,
            Intro {
                bars: intro_bars,
                up: in_up,
                answer: in_answer,
                mirror: in_mirror,
                counter: in_counter,
                run: in_run,
                arp: in_arp,
            },
            mel_a,
        );
    }
    let mut t0 = intro_ticks;
    let mut fast: u32 = NO_FAST;
    let mut gl_ev: Array<u64> = array![];
    let walk_tunes: u32 = *[12_u32, 12, 8, 4].span().at(walk_span);
    for sec in 0..4_u32 {
        let kind = *kinds.at(sec);
        let chords = *nums.at(kind);
        let m = if kind == 3 {
            mel_d
        } else if kind == 2 {
            mel_c
        } else if (kind == 1) != (knob == 1) {
            mel_b
        } else {
            mel_a
        };
        let plain = sec < 3 && *kinds.at(sec + 1) == kind;
        lead_section(ref w, ctx, m, chords, t0, kind, *doubled.at(sec), plain);
        let walks = walking && (walk_tunes / *[1_u32, 2, 4, 8].span().at(sec)) % 2 == 1;
        if walks && parts & BASS != 0 {
            let next = if sec < 3 {
                Option::Some(deg(*(*nums.at(*kinds.at(sec + 1))).at(0)))
            } else {
                Option::None
            };
            let wseed = mix(
                mix(walk_seed, sec),
                match month {
                    Option::Some(m) => m,
                    Option::None => 0,
                },
            );
            walk_section(ref w.bass, ctx, chords, next, t0, wseed);
        }
        for b in 0..8_u32 {
            let t = t0 + b * bar;
            let tok = *chords.at(b);
            accomp_bar(ref w.accomp, ctx, tok, kind, b, t, ref fast);
            let ending = if b == 7 {
                *drum_ends.at(sec)
            } else {
                0
            };
            rhythm_bar(ref w, ctx, tok, b, t, walks, ending);
        }
        t0 += 8 * bar;
        if let Option::Some(plan) = gl_plan {
            if plan.spot == sec {
                let tok = *chords.at(7);
                let span = if s.den == 8 {
                    720
                } else if bar < 960 {
                    bar
                } else {
                    960
                };
                let last = if sec == 3 {
                    t0
                } else {
                    t0 + 480
                };
                for n in glissando(plan, t0, span, gl_seed, last) {
                    let p: u32 = pt(base, home, n.d, tok).try_into().unwrap();
                    ev_push(ref gl_ev, n.t, true, p, n.v);
                    ev_push(ref gl_ev, n.t + n.len, false, p, 0);
                }
            }
        }
    }
    let ticks = t0;
    // the tempo
    let mut us = (120000000 + bpm) / (2 * bpm);
    if knob >= 2 && knob <= 5 {
        let x = nudge_tempo(us, delta);
        us = if x > MAX_TEMPO_US {
            MAX_TEMPO_US
        } else {
            x
        };
    }
    let mut tempo = TrackWriterTrait::new();
    tempo.tempo(0, us);
    let den_log: u8 = if s.den == 8 {
        3
    } else {
        2
    };
    tempo.meta(0, 0x58, [s.num.try_into().unwrap(), den_log, 24, 8].span());
    let Writers { lead, alt, mega: mega_w, descant, accomp: accomp_w, bass: bass_w, pad, perc: perc_w } =
        w;
    let mut tracks: Array<Array<u8>> = array![tempo.finish_at(ticks), lead.finish_at(ticks)];
    if parts & DESCANT != 0 || any_doubled {
        tracks.append(descant.finish_at(ticks));
    }
    tracks.append(accomp_w.finish_at(ticks));
    if parts & BASS != 0 {
        tracks.append(bass_w.finish_at(ticks));
    }
    if parts & PAD != 0 {
        tracks.append(pad.finish_at(ticks));
    }
    if parts & PERC != 0 {
        tracks.append(perc_w.finish_at(ticks));
    }
    if mega {
        tracks.append(mega_w.finish_at(ticks));
    }
    if gl_ev.len() > 0 {
        let mut g = channel_track(GLISS_CHANNEL, acc_p, flags);
        ev_write(ref g, GLISS_CHANNEL, gl_ev.span());
        tracks.append(g.finish_at(ticks));
    }
    if alt_kind != NO_KIND {
        tracks.append(alt.finish_at(ticks));
    }
    tracks
}

/// Edition `e`'s track as a Standard MIDI File (format 1, 480 ticks per quarter note):
/// loot_editions.js `editionMidi(species, mega, e, seed, drift).midi`.
pub fn edition_smf_bytes(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>,
) -> Array<u8> {
    smf_bytes(1, 480, edition_tracks(species, mega, e, seed, drift).span())
}

/// The same as a `ByteArray`.
pub fn edition_byte_array(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>,
) -> ByteArray {
    smf_byte_array(1, 480, edition_tracks(species, mega, e, seed, drift).span())
}
