//! Loot Dungeon Monthly Track Editions: the Cairo port of offchain/loot-sound/src/loot_editions.js
//! (`editionMidi` with its lab-only knobs at their defaults: plainChords false, walk and intro as the
//! purchase draws them), byte for byte. The tables (styles, numerals, colours, walking lines) are in
//! editions_data.cairo, generated by offchain/loot-sound/onchain/make_cairo_editions.mjs.
//!
//! The JS writes every part into its own track as it goes; this port writes one track at a time
//! (`part`, as the Beasts port does), each in the same order. Where the JS sorts a bar's events
//! (the accompaniment's spread chords, the intro's groove, the glissando) this sorts too: events
//! are packed into u64 keys (time, off before on, insertion order) and merge-sorted, which is the
//! JS's stable sort.
//!
//! CASM size: the melody's degrees are i32 (it compares them); the part writers carry degrees,
//! pitches and velocities as felt252 (no overflow paths), and `block` drops a pitch outside 0-127
//! by its failed conversion to u8, as the JS filters it.

use beast_composer::composition::drift::{Drift, nudge_tempo};
use beast_composer::opaque::opaque;
use midi::smf::{smf_byte_array, smf_bytes};
use crate::writer::{TrackWriter, TrackWriterTrait, byte as b8};
use crate::common::{
    GLISS_CHANNEL, GlissPlan, Rng, RngTrait, fold64, gliss_plan, glissando, mix, u32_of, wmul,
};
use crate::editions_data::{
    COLOURS, INTRO_PLAN, SCALES, STYLE_COUNT, SUBS, SUBS_AT, Style, WALKS, style,
};
use crate::orchestra::{scaled, vol_k};
use crate::orchestra_data::LOW;
use crate::species::loot_species;

const SEVEN: NonZero<u32> = 7;
const MAX_TEMPO_US: u32 = 1048575;
const MEGA_LEADS: [u32; 2] = [50, 65];
const VOL: [u32; 10] = [100, 64, 74, 100, 58, 62, 70, 100, 0, 70];
const PAN: [u8; 10] = [64, 46, 82, 64, 64, 88, 100, 76, 0, 64];
/// The forms' tunes, 2 bits each: AABA, ABAB, AABB, ABAC, ADBA, ABDB, ADBD, ABDC (A 0, B 1, C 2,
/// A' 3).
const FORMS: [u32; 8] = [16, 68, 80, 132, 28, 116, 220, 180];
const QUICKER: [u32; 9] = [0, 0, 0, 8, 14, 20, 26, 34, 42];
const SLOW_TOP: u32 = 124;
const ROT: [felt252; 5] = [0, 2, 4, 7, 9];
const SNAP: [i32; 7] = [0, -1, 0, -1, 0, -1, 1];
const DRUM_FILL: [felt252; 8] = [38, 38, 50, 48, 47, 45, 43, 41];
const ALT_CHANNEL: u8 = 7;
const NO_KIND: u32 = 9;
const NO_FAST: u32 = 0xffff;
/// The parts beside the lead and accompaniment (loot_editions.js PARTS): bits 0-3.
const DESCANT: u32 = 1;
const BASS: u32 = 2;
const PAD: u32 = 4;
const PERC: u32 = 8;

// ── small helpers ──

fn f(x: u32) -> felt252 {
    x.into()
}

/// d mod 7 (d >= -70).
#[inline(never)]
fn m7(d: felt252) -> u32 {
    let (_, r) = DivRem::div_rem(u32_of(d + 70), SEVEN);
    r
}

/// The scale a chord token plays in: the home scale (colour 0) or the colour it borrows.
#[inline(never)]
fn scale_of(home: u32, tok: u32) -> u32 {
    let (q, _) = DivRem::div_rem(tok, 8);
    let (_, col) = DivRem::div_rem(q, 16);
    if col == 0 {
        home
    } else {
        match COLOURS.span().get(col) {
            Option::Some(c) => *c.unbox(),
            Option::None => home,
        }
    }
}

/// `pitch(base, scale, d)`: base + 12 floor(d / 7) + scale[d mod 7].
#[inline(never)]
fn pitch(base: felt252, scale: u32, d: felt252) -> felt252 {
    let (o, i) = DivRem::div_rem(u32_of(d + 70), SEVEN);
    // step i of the scale (4 bits each)
    let p: NonZero<u32> = if i == 0 {
        1
    } else if i == 1 {
        0x10
    } else if i == 2 {
        0x100
    } else if i == 3 {
        0x1000
    } else if i == 4 {
        0x10000
    } else if i == 5 {
        0x100000
    } else {
        0x1000000
    };
    let (q, _) = DivRem::div_rem(scale, p);
    let (_, s) = DivRem::div_rem(q, 16);
    base + 12 * o.into() - 120 + s.into()
}

/// Degree `d` in chord `tok`'s colour (the source's `P` and `PB`).
#[inline(never)]
fn pt(base: felt252, home: u32, d: felt252, tok: u32) -> felt252 {
    pitch(base, scale_of(home, tok), d)
}

/// The melody's `snap`: `d` to the nearest tone of the triad on `c`.
#[inline(never)]
fn snap(d: i32, c: i32) -> i32 {
    let x: felt252 = d.into() - c.into();
    d + *SNAP.span().at(m7(x))
}

/// The root of the triad on `c`, placed in [lo, lo + 6].
fn triad_root(c: felt252, lo: felt252) -> felt252 {
    lo + m7(c - lo).into()
}

fn deg(tok: u32) -> felt252 {
    (tok % 8).into()
}

fn deg_i(tok: u32) -> i32 {
    (tok % 8).try_into().unwrap()
}

fn sev(tok: u32) -> bool {
    tok >= 128
}

/// A velocity held to 1-127 (velocities here are above -256 and below 256).
#[inline(never)]
fn vel(v: felt252) -> u8 {
    match v.try_into() {
        Option::Some(x) => if x < 1 {
            1
        } else if x > 127 {
            127
        } else {
            x
        },
        Option::None => 1,
    }
}

/// Math.round(a / b) for a >= 0, b > 0.
#[inline(never)]
fn round_div(a: u32, b: u32) -> felt252 {
    ((2 * a + b) / (2 * b)).into()
}

/// `Track.block`: every note on at `t`, then every note off at `t + d`; pitches outside 0-127 are
/// dropped, the velocity held to 1-127, nothing when d <= 0.
#[inline(never)]
fn block(ref tw: TrackWriter, ch: u8, t: u32, d: felt252, ps: Span<felt252>, v: felt252) {
    let d: u32 = match d.try_into() {
        Option::Some(x) => x,
        Option::None => { return; },
    };
    if d == 0 {
        return;
    }
    let v = vel(v);
    let mut keys: Array<u8> = array![];
    for p in ps {
        let p: Option<u8> = (*p).try_into();
        if let Option::Some(p) = p {
            if p < 128 {
                keys.append(p);
            }
        }
    }
    for p in keys.span() {
        tw.message(t, 0x90 + ch, *p, v);
    }
    for p in keys.span() {
        tw.message(t + d, 0x80 + ch, *p, 0);
    }
}

/// `block` of one note.
#[inline(never)]
fn one(ref tw: TrackWriter, ch: u8, t: u32, d: felt252, p: felt252, v: felt252) {
    // `block` of one pitch, without its loops (no panic path: CASM size)
    let d: u32 = match d.try_into() {
        Option::Some(x) => x,
        Option::None => { return; },
    };
    let p: u8 = match p.try_into() {
        Option::Some(x) => x,
        Option::None => { return; },
    };
    if d == 0 || p >= 128 {
        return;
    }
    tw.message(t, b8(0x90 + ch.into()), p, vel(v));
    tw.message(u32_of(t.into() + d.into()), b8(0x80 + ch.into()), p, 0);
}

/// An event to sort: time, off (0) before on (1), then the order it was made in.
#[inline(never)]
fn ev_push(ref ev: Array<u64>, t: u32, on: bool, p: u32, v: u8) {
    let idx: felt252 = ev.len().into();
    let flag: felt252 = if on {
        1
    } else {
        0
    };
    let k: felt252 = ((t.into() * 2 + flag) * 1024 + idx) * 16384 + p.into() * 128 + v.into();
    ev.append(
        match k.try_into() {
            Option::Some(x) => x,
            Option::None => 0,
        },
    );
}

/// The events sorted, written as note ons and offs on channel `ch`.
#[inline(never)]
fn ev_write(ref tw: TrackWriter, ch: u8, ev: Span<u64>) {
    // (the keys are distinct: each carries its event's index)
    for x in crate::rounds::sort_keys(ev) {
        let x = *x;
        let v: u8 = (x % 128).try_into().unwrap();
        let p: u8 = ((x / 128) % 128).try_into().unwrap();
        let key = x / 16384;
        let t: u32 = (key / 2048).try_into().unwrap();
        if (key / 1024) % 2 == 1 {
            tw.message(t, 0x90 + ch, p, v);
        } else {
            tw.message(t, 0x80 + ch, p, 0);
        }
    }
}

/// CC 7 as a mix level (loot_editions.js volOf).
fn vol_of(flags: u32, ch: u8, program: u32) -> u8 {
    let k: u32 = if (flags % 2 == 1 && ch == 3) || ((flags / 2) % 2 == 1 && ch == 2) {
        837
    } else if (ch == 0 || ch == 1) && program == 72 {
        725
    } else if (ch == 0 || ch == 1) && program == 62 {
        949
    } else if ch == 2 && program == 99 {
        837
    } else if ch == 4 && program == 33 {
        1072
    } else {
        1000
    };
    let v = *VOL.span().at(ch.into());
    ((v * k + 500) / 1000).try_into().unwrap()
}

/// A channel's track, opened with its program, volume, pan and reverb.
#[inline(never)]
fn channel_track(ch: u8, program: u32, c: @Ctx) -> TrackWriter {
    let (flags, band): (u32, Span<u8>) = (c.flags, c.band);
    let mut tw = TrackWriterTrait::new();
    // the band's instrument when one is given (the lab's setProgram override; drums keep theirs);
    // the volume still follows the written program, as in the lab
    // (an accompaniment written an octave lower plays the band's low instrument, pizzicato)
    let played: u8 = if band.len() != 0 && ch == 2 && c.acc_down {
        LOW
    } else if band.len() != 0 && ch != 9 {
        *band.at(ch.into() % band.len())
    } else {
        program.try_into().unwrap()
    };
    tw.message1(0, 0xC0 + ch, played);
    // the volumes on the band's instrument (loot-lab.mjs track0: sample banks, as played): the
    // style's MIX, and on the lead channels (0 and the second lead) LEAD_SOFT x LEAD_ALL, then
    // LEAD_DROP
    let vol = vol_of(flags, ch, program);
    let vol = if band.len() != 0 && ch < 8 {
        let (k, d) = vol_k(if ch == 0 || ch == ALT_CHANNEL {
            1
        } else {
            0
        }, c.style, played);
        scaled(vol, k, d)
    } else {
        vol
    };
    tw.message(0, 0xB0 + ch, 7, vol);
    tw.message(0, 0xB0 + ch, 10, *PAN.span().at(ch.into()));
    tw.message(0, 0xB0 + ch, 91, 40);
    tw
}

#[inline(never)]
fn stream(fold: u32, e: u32, id: u32, a: u32, b: u32) -> Rng {
    RngTrait::new(fold ^ wmul(e, a) ^ wmul(id, b))
}

fn low32(x: felt252) -> u32 {
    crate::rounds::low32(x)
}

/// Byte `k` of a packed word (tokens).
#[inline(never)]
fn byte(x: u32, k: u32) -> u32 {
    (x / *[1_u32, 0x100, 0x10000, 0x1000000].span().at(k)) % 256
}

// ── chords ──

/// A chord's substitute in an answering phrase (the source's `sub`): drawn when it has any.
#[inline(never)]
fn sub(home: u32, tok: u32, ref h: Rng) -> u32 {
    let subs = SUBS.span();
    let mut k = *SUBS_AT.span().at(home);
    let end = *SUBS_AT.span().at(home + 1);
    let t: u64 = tok.into();
    while k < end {
        let x = *subs.at(k);
        if x % 256 == t {
            let n: u32 = ((x / 256) % 8).try_into().unwrap();
            let j = h.int(n);
            let sh = *[0x800_u64, 0x80000, 0x8000000, 0x800000000].span().at(j);
            return ((x / sh) % 256).try_into().unwrap();
        }
        k += 1;
    }
    tok
}

#[inline(never)]
fn maybe(home: u32, tok: u32, ref h: Rng) -> u32 {
    if h.int(2) == 1 {
        sub(home, tok, ref h)
    } else {
        tok
    }
}

/// A section's 8 chord tokens (loot_editions.js sectionNumerals).
#[inline(never)]
fn section_chords(s: Box<Style>, p: u32, closing: bool, ref h: Rng) -> Span<u32> {
    let s = s.unbox();
    let cads = if closing {
        s.cad_close
    } else {
        s.cad_open
    };
    let cad = *cads.at(h.int(cads.len()));
    let (c0, c1) = (cad % 256, cad / 256);
    let lo = *s.progs.at(2 * p);
    let hi = *s.progs.at(2 * p + 1);
    let (p0, p1, p2, p3) = (byte(lo, 0), byte(lo, 1), byte(lo, 2), byte(lo, 3));
    if hi != 0xffffffff {
        return [p0, p1, p2, p3, byte(hi, 0), byte(hi, 1), byte(hi, 2), byte(hi, 3)].span();
    }
    let home = s.home;
    if s.chord_bars == 1 {
        let m = maybe(home, p0, ref h);
        let x = sub(home, p1, ref h);
        [p0, p1, p2, p3, m, x, c0, c1].span()
    } else {
        let x = sub(home, p1, ref h);
        let m = maybe(home, p2, ref h);
        [p0, p0, p1, x, p2, m, c0, p3].span()
    }
}

// ── melody ──

#[derive(Copy, Drop)]
struct Note {
    t: u32,
    len: u32,
    d: i32,
}

#[derive(Copy, Drop)]
struct Mel {
    bar: u32,
    strong2: u32,
    lo: i32,
    motif: Span<i32>,
}

#[inline(never)]
fn strong(t: u32, bar: u32, strong2: u32) -> bool {
    let pos = t % bar;
    pos == 0 || (strong2 > 0 && pos == strong2)
}

/// One bar of a melody from its rhythm `cell` (eighths, 4 bits each).
#[inline(never)]
fn melody_bar(
    m: Box<Mel>, ref out: Array<Note>, ref prev: i32, ref mi: u32, ref r: Rng, cell: u32, b: u32,
    ch: i32, full: bool,
) {
    let m = m.unbox();
    let (lo, motif) = (m.lo, m.motif);
    let hi = lo + 10;
    let mut cell = cell;
    let mut t = b * m.bar;
    let target = lo + *[3_i32, 5, 6, 5].span().at(b % 4);
    while cell != 0 {
        let len = (cell % 16) * 240;
        cell /= 16;
        let mut d = if mi < motif.len() {
            let mut d = *motif.at(mi);
            mi += 1;
            while d > hi {
                d -= 7;
            }
            while d < lo {
                d += 7;
            }
            d
        } else {
            let dir: i32 = if prev < target - 1 {
                1
            } else if prev > target + 1 {
                -1
            } else if r.int(2) == 1 {
                1
            } else {
                -1
            };
            let x = r.int(100);
            let step = if x < 12 {
                0
            } else if x < 66 {
                dir
            } else if x < 90 {
                2 * dir
            } else {
                -dir
            };
            let d = prev + step;
            if d > hi {
                hi
            } else if d < lo {
                lo
            } else {
                d
            }
        };
        if strong(t, m.bar, m.strong2) || len >= 720 {
            d = snap(d, ch);
        }
        if cell == 0 && b == 7 && full {
            d = if prev >= 4 {
                7
            } else {
                0
            };
        } else if cell == 0 && (b == 3 || b == 7) {
            d = if prev >= 1 {
                4
            } else {
                -3
            };
        }
        out.append(Note { t, len, d });
        prev = d;
        t += len;
    }
}

/// A section's melody over its chords (the source's `melody`).
#[inline(never)]
fn melody(
    cells: Span<u32>, ends: Span<u32>, m: Box<Mel>, chords: Span<u32>, full: bool, ref r: Rng,
) -> Span<Note> {
    let mm = m.unbox();
    let (bar, strong2, lo) = (mm.bar, mm.strong2, mm.lo);
    let idea0 = *cells.at(r.int(cells.len()));
    let idea1 = *cells.at(r.int(cells.len()));
    let c2 = *cells.at(r.int(cells.len()));
    let e3 = *ends.at(r.int(ends.len()));
    let c6 = *cells.at(r.int(cells.len()));
    let e7 = *ends.at(r.int(ends.len()));
    let mut out: Array<Note> = array![];
    let mut prev = lo + 3;
    let mut mi: u32 = 0;
    let plan = [idea0, idea1, c2, e3, 0, 0, c6, e7];
    for b in 0..8_u32 {
        let ch = deg_i(*chords.at(b));
        if b == 4 || b == 5 {
            let (from, to) = ((b - 4) * bar, (b - 3) * bar);
            let src = out.span();
            for n in src {
                let n = *n;
                if n.t >= from && to > n.t {
                    let t = n.t + 4 * bar;
                    let d = if strong(t, bar, strong2) {
                        snap(n.d, ch)
                    } else {
                        n.d
                    };
                    out.append(Note { t, len: n.len, d });
                    prev = d;
                }
            }
            continue;
        }
        melody_bar(m, ref out, ref prev, ref mi, ref r, *plan.span().at(b), b, ch, full);
    }
    out.span()
}


// ── spread chords ──

/// loot_editions.js spreadOf: 0 struck, 1-2 rolled up or down, 3-4 an arpeggio up or up and back.
fn spread_of(seed: u32, share: u32, lean: u32, kind: u32, bar: u32) -> u32 {
    let h = mix(seed, kind * 16 + bar);
    if h % 100 >= share {
        return 0;
    }
    let arp = lean == 1 || (lean == 2 && (h / 0x100) % 2 == 1);
    (if arp {
        3
    } else {
        1
    }) + if (h / 0x1000) % 3 == 0 {
        1
    } else {
        0
    }
}

/// loot_editions.js spreadStep: drawn by weight (eighths 8, sixteenths 8, thirty-seconds 1) from
/// the subdivisions that fit `room` twice; thirty-seconds alone one time in ten, else none.
fn spread_step(seed: u32, kind: u32, bar: u32, room: u32) -> u32 {
    let h = mix(seed ^ 0x53544550, kind * 16 + bar) / 16;
    if room < 120 {
        0
    } else if room < 240 {
        if h % 10 == 0 {
            60
        } else {
            0
        }
    } else if room < 480 {
        if h % 9 < 8 {
            120
        } else {
            60
        }
    } else {
        let k = h % 17;
        if k < 8 {
            240
        } else if k < 16 {
            120
        } else {
            60
        }
    }
}

/// The pitches in 0-127, sorted and without repeats.
#[inline(never)]
fn sorted_unique(ps: Span<felt252>) -> Span<u32> {
    let mut xs: Array<u32> = array![];
    for p in ps {
        let p: Option<u8> = (*p).try_into();
        if let Option::Some(p) = p {
            if p < 128 {
                xs.append(p.into());
            }
        }
    }
    let xs = xs.span();
    let mut out: Array<u32> = array![];
    let mut last: u32 = 0;
    let mut first = true;
    loop {
        let mut best: u32 = 128;
        for p in xs {
            let p = *p;
            if (first || p > last) && p < best {
                best = p;
            }
        }
        if best == 128 {
            break;
        }
        out.append(best);
        last = best;
        first = false;
    }
    out.span()
}

/// loot_editions.js spreadChord, its notes pushed as sortable events (on, then off, each note).
#[inline(never)]
fn spread_chord(
    ref ev: Array<u64>, how: u32, t: u32, d: u32, room: u32, ps: Span<felt252>, v: felt252,
    step: u32,
) {
    let ps = sorted_unique(ps);
    let np = ps.len();
    if how == 0 || np < 2 || d < 100 {
        for p in ps {
            ev_push(ref ev, t, true, *p, vel(v));
            ev_push(ref ev, t + d, false, *p, 0);
        }
        return;
    }
    let n = if step == 0 {
        0
    } else {
        let a = room / step;
        let b = if d >= 480 {
            let x = (d + 40) / step;
            if x < 2 {
                2
            } else {
                x
            }
        } else {
            np
        };
        if a < b {
            a
        } else {
            b
        }
    };
    if how >= 3 && n >= 2 {
        let cyc = if how == 4 && np > 2 {
            2 * np - 2
        } else {
            np
        };
        for k in 0..n {
            let at = k % cyc;
            let p = *ps.at(if at < np {
                at
            } else {
                2 * np - 2 - at
            });
            let len = if k == n - 1 && d > k * step + step - 20 {
                d - k * step
            } else {
                step - 20
            };
            let nt = t + k * step;
            ev_push(ref ev, nt, true, p, vel(if k == 0 {
                v
            } else {
                v - 6
            }));
            ev_push(ref ev, nt + len, false, p, 0);
        }
        return;
    }
    let g = d / (2 * np);
    let top = if d >= 400 {
        40
    } else {
        20
    };
    let gap = if g < top {
        g
    } else {
        top
    };
    let down = how == 2 || how == 4;
    for k in 0..np {
        let p = *ps.at(if down {
            np - 1 - k
        } else {
            k
        });
        let nt = t + k * gap;
        ev_push(ref ev, nt, true, p, vel(if k == np - 1 {
            v + 4
        } else {
            v - 4
        }));
        ev_push(ref ev, t + d, false, p, 0);
    }
}

// ── the purchase ──

/// The intro's draws (loot_editions.js, stream IN).
#[derive(Copy, Drop)]
struct Intro {
    bars: u32,
    up: bool,
    answer: felt252,
    mirror: bool,
    counter: bool,
    run: bool,
    arp: bool,
}

/// What the part writers read, boxed. The parts are written one track at a time (`role`: the
/// channel, 0 lead, 1 descant, 2 accompaniment, 3 bass, 4 pad, 5 mega, 7 second lead, 9 drums).
#[derive(Copy, Drop)]
struct Ctx {
    s: Box<Style>,
    /// the style's index (its MIX)
    style: u32,
    base: felt252,
    home: u32,
    bar: u32,
    rot: u32,
    parts: u32,
    acc_down: bool,
    /// the accompaniment's octave doubling: 12, or -12 (below the root, one purchase in three)
    octave: felt252,
    detached: bool,
    accomp: Span<u32>,
    bass: Span<u32>,
    perc: Span<u32>,
    bass_mode: u32,
    orn: u32,
    orn_seed: u32,
    orn_kind: u32,
    alt_kind: u32,
    intro: Intro,
    intro_ticks: u32,
    spread_share: u32,
    spread_lean: u32,
    spread_seed: u32,
    flags: u32,
    /// the four tunes' kinds, each kind's chords and melody (after the day's swap), the A tune as
    /// written (the intro's call)
    kinds: Span<u32>,
    nums: Span<Span<u32>>,
    mels: Span<Span<Note>>,
    mel_a: Span<Note>,
    /// the last tune's melody: a third higher when the form ends on A or A' (`grand`)
    last_mel: Span<Note>,
    doubled: Span<felt252>,
    drum_ends: Span<u32>,
    /// the walking bass: which tunes (bits), its seed, the month's hash (0: none)
    walk_tunes: u32,
    walk_seed: u32,
    month: u32,
    /// The instruments the channels play (orchestra::band), or empty: as written.
    band: Span<u8>,
}

fn gap_of(detached: bool, len: u32) -> u32 {
    if detached && len <= 240 {
        len / 2
    } else {
        20
    }
}

/// A note's sounding length (the source's `n.len - gap(n.len)`).
fn sound(detached: bool, len: u32) -> felt252 {
    f(len - gap_of(detached, len))
}

/// The accompaniment's three voices on chord `tok` (root, then the week's inversion).
#[inline(never)]
fn voicing(k: Box<Ctx>, tok: u32) -> (felt252, felt252, felt252, felt252) {
    let c = k.unbox();
    let r = triad_root(deg(tok), -3);
    let rot = c.rot;
    let (base, home) = (c.base, c.home);
    (
        r,
        pt(base, home, r + *ROT.span().at(rot), tok),
        pt(base, home, r + *ROT.span().at(rot + 1), tok),
        pt(base, home, r + *ROT.span().at(rot + 2), tok),
    )
}

/// An accompaniment event's pitches by voice (9 the chord, with `seventh`; 10 root and octave; 3
/// the octave; 0-2 one tone), moved by `low`; the octave doubling `octave` (12, or -12 below the
/// root: then voice 3 is the root itself).
#[inline(never)]
fn voices(
    voice: u32,
    p0: felt252,
    p1: felt252,
    p2: felt252,
    seventh: Option<felt252>,
    low: felt252,
    octave: felt252,
) -> Span<felt252> {
    if voice == 9 {
        match seventh {
            Option::Some(x) => array![p0 + low, p1 + low, p2 + low, x + low].span(),
            Option::None => array![p0 + low, p1 + low, p2 + low].span(),
        }
    } else if voice == 10 {
        array![p0 + low, p0 + octave + low].span()
    } else if voice == 3 {
        array![p0 + if octave == 12 {
            12
        } else {
            0
        } + low]
            .span()
    } else if voice == 0 {
        array![p0 + low].span()
    } else if voice == 1 {
        array![p1 + low].span()
    } else {
        array![p2 + low].span()
    }
}

/// An accompaniment or bass figure event: offset, duration, voice (bass: tone), velocity delta.
#[inline(never)]
fn fig(x: u32) -> (u32, u32, u32, felt252) {
    (x % 2048, (x / 2048) % 2048, (x / 0x400000) % 16, f(x / 0x4000000) - 32)
}

/// The room an accompaniment event has: to the next event, or to the bar's end.
fn room_of(acc: Span<u32>, j: u32, off: u32, bar: u32) -> u32 {
    if j + 1 < acc.len() {
        *acc.at(j + 1) % 2048 - off
    } else {
        bar - off
    }
}

/// A drum fill of `count` sixteenths from `t`: snare, then down the toms, rising from `v0` by up
/// to `rise`.
#[inline(never)]
fn drum_fill(ref tw: TrackWriter, t: u32, count: u32, v0: felt252, rise: u32) {
    let mut x: u32 = opaque(0);
    while x < count {
        let k = (x * 8) / count;
        let k = if k > 7 {
            7
        } else {
            k
        };
        one(ref tw, 9, t + x * 120, 100, *DRUM_FILL.span().at(k), v0 + round_div(rise * x, count));
        x += 1;
    }
}

/// The pad's chord on `tok` (with its seventh), from `t` for `d` ticks.
#[inline(never)]
fn pad_chord(ref tw: TrackWriter, k: Box<Ctx>, tok: u32, t: u32, d: felt252, v: felt252) {
    let c = k.unbox();
    let (base, home) = (c.base, c.home);
    let r = triad_root(deg(tok), -7);
    let mut ps = array![
        pt(base, home, r, tok), pt(base, home, r + 2, tok), pt(base, home, r + 4, tok),
    ];
    if sev(tok) {
        ps.append(pt(base, home, r + 6, tok));
    }
    block(ref tw, 4, t, d, ps.span(), v);
}

/// The intro's call, or an answer to it, from tick `t`: each note's degree `d` as `add - d`
/// (`neg`) or `add + d`, held its length less `cut` (0: less the tune's phrasing gap).
#[inline(never)]
fn call_line(
    ref tw: TrackWriter,
    ch: u8,
    t: u32,
    call: Span<Note>,
    neg: bool,
    add: felt252,
    base: felt252,
    home: u32,
    tok: u32,
    v: felt252,
    cut: u32,
) {
    for n in call {
        let d: felt252 = n.d.into();
        let len = if cut == 0 {
            n.len - gap_of(true, n.len)
        } else {
            n.len - cut
        };
        one(ref tw, ch, t + n.t, f(len), pt(base, home, if neg {
            add - d
        } else {
            add + d
        }, tok), v);
    }
}

/// The intro before the first tune (loot_editions.js, `introBars`), the part `role` plays in it.
#[inline(never)]
fn intro(ref tw: TrackWriter, k: Box<Ctx>, role: u32) {
    if role == 1 || role == 5 || role == 7 {
        return;
    }
    let c = k.unbox();
    let s = c.s.unbox();
    let (num, den) = (s.num, s.den);
    let (acc, octave) = (c.accomp, c.octave);
    let it = c.intro;
    let n_bars = it.bars;
    let mel_a = c.mel_a;
    let (base, home, bar) = (c.base, c.home, c.bar);
    let bass_base = base - 24;
    let plan = *INTRO_PLAN.span().at(s.home);
    let first: felt252 = (*mel_a.at(0)).d.into();
    let half = bar / 2;
    let run_len = half / 120;
    let dir: felt252 = if it.up {
        1
    } else {
        -1
    };
    let mut call: Array<Note> = array![];
    for n in mel_a {
        if n.t + n.len <= half {
            call.append(*n);
        }
    }
    if call.len() == 0 {
        call.append(Note { t: 0, len: half, d: (*mel_a.at(0)).d });
    }
    let call = call.span();
    let low: felt252 = if c.acc_down {
        -12
    } else {
        0
    };
    // the tune's phrasing: 0 (its gap) or a fixed gap
    let gap: u32 = if c.detached {
        0
    } else {
        20
    };
    let mut kb: u32 = opaque(0);
    while kb < n_bars {
        let t = kb * bar;
        let tok = byte(plan, 4 - n_bars + kb);
        let ch = deg(tok);
        let last = kb == n_bars - 1;
        let swell = round_div(14 * (kb + 1), n_bars);
        let seq = f(kb) - f(n_bars - 1);
        let groove = n_bars >= 3 && kb == 0;
        if role == 4 {
            pad_chord(ref tw, k, tok, t, f(bar) - 40, 34 + swell);
        } else if role == 3 {
            if it.counter && !groove && call.len() > 1 {
                call_line(ref tw, 3, t, call, true, ch + first, bass_base, home, tok, 70 + swell, 20);
                one(ref tw, 3, t + half, f(half) - 30, pt(bass_base, home, ch, tok), 68 + swell);
            } else {
                one(ref tw, 3, t, f(bar) - 30, pt(bass_base, home, ch, tok), 68 + swell);
            }
        } else if role == 2 {
            let (v0, p0, p1, p2) = voicing(k, tok);
            if last && it.arp {
                let steps = [0, 2, 4, 7, 9, 11, 14];
                let count = bar / 120;
                for x in 0..count {
                    let up = if 2 * x < count {
                        x
                    } else {
                        count - 1 - x
                    };
                    one(
                        ref tw,
                        2,
                        t + x * 120,
                        110,
                        pt(base, home, v0 + *steps.span().at(up % 7), tok) + low,
                        36 + round_div(16 * x, count),
                    );
                }
            } else if groove {
                let mut ev: Array<u64> = array![];
                for j in 0..acc.len() {
                    let (off, d, voice, dv) = fig(*acc.at(j));
                    let room = room_of(acc, j, off, bar);
                    let m = if d < room {
                        d
                    } else {
                        room
                    };
                    let len = if m < 40 {
                        30
                    } else {
                        m - 10
                    };
                    let v = vel(50 + swell + dv);
                    for p in voices(voice, p0, p1, p2, Option::None, low, octave) {
                        let p: u32 = (*p).try_into().unwrap();
                        ev_push(ref ev, t + off, true, p, v);
                        ev_push(ref ev, t + off + len, false, p, 0);
                    }
                }
                ev_write(ref tw, 2, ev.span());
            } else {
                let add = if it.mirror {
                    2 * first
                } else {
                    0
                } + seq + it.answer;
                call_line(ref tw, 2, t + half, call, it.mirror, add, base, home, tok, 62 + swell, gap);
            }
        } else if role == 0 {
            if !groove {
                call_line(ref tw, 0, t, call, false, seq, base, home, tok, 70 + swell, gap);
            }
            if last && it.run {
                for x in 0..run_len {
                    one(
                        ref tw,
                        0,
                        t + half + x * 120,
                        105,
                        pt(base, home, first - f(run_len - x) * dir, tok),
                        44 + round_div(14 * x, run_len),
                    );
                }
            }
        } else {
            if n_bars > 1 {
                let (nb, step) = if den == 8 {
                    (2, 720)
                } else {
                    (num, 480)
                };
                // 34 + (swell >> 1)
                let v = 34 + f((28 * (kb + 1) + n_bars) / (2 * n_bars) / 2);
                for j in 0..nb {
                    let off = j * step;
                    if !last || off < half {
                        one(ref tw, 9, t + off, 100, 42, v);
                    }
                }
            }
            if last {
                drum_fill(ref tw, t + half, run_len, 28, 16);
            }
        }
        kb += 1;
    }
}

/// A tune's notes in the part `role` plays (lead, its mega double, the second lead or the
/// descant) from tick `t0`.
#[inline(never)]
fn lead_section(
    ref tw: TrackWriter,
    k: Box<Ctx>,
    role: u32,
    m: Span<Note>,
    chords: Span<u32>,
    t0: u32,
    kind: u32,
    doubled: felt252,
    plain: bool,
) {
    let c = k.unbox();
    let alt = kind == c.alt_kind;
    if (role == 0 && alt) || (role == 7 && !alt) {
        return;
    }
    let (base, home, bar) = (c.base, c.home, c.bar);
    let (detached, parts, orn, orn_seed, orn_kind, intro_ticks) = (
        c.detached, c.parts, c.orn, c.orn_seed, c.orn_kind, c.intro_ticks,
    );
    let (ch, up): (u8, felt252) = if role == 5 {
        (5, 12)
    } else {
        (role.try_into().unwrap(), 0)
    };
    for n in m {
        let n = *n;
        let t = t0 + n.t;
        let len = sound(detached, n.len);
        let tok = *chords.at(n.t / bar);
        let d: felt252 = n.d.into();
        if role == 1 {
            if doubled != 0 {
                one(ref tw, 1, t, len, pt(base, home, d + doubled, tok), 70);
            } else if n.len >= 480 && parts & DESCANT != 0 && !plain {
                one(ref tw, 1, t, len, pt(base, home, d + 2, tok), 64);
            }
            continue;
        }
        let d70: u32 = (d + 70).try_into().unwrap();
        let grace = orn > 0
            && n.len >= 480
            && (((t - intro_ticks) / 240) * 7 + d70 * 13 + orn_seed) % 100 < orn;
        let v: felt252 = if role == 5 {
            70
        } else if n.t % bar != 0 {
            90
        } else {
            100
        };
        let main = pt(base, home, d, tok) + up;
        if grace && orn_kind == 3 {
            one(ref tw, ch, t, 60, main, v);
            one(ref tw, ch, t + 60, 60, pt(base, home, d + 1, tok) + up, v - 10);
            one(ref tw, ch, t + 120, len - 120, main, v);
        } else if grace {
            let g = pt(base, home, d + *[1, -1, -2].span().at(orn_kind), tok);
            one(ref tw, ch, t, 80, g + up, v - 10);
            one(ref tw, ch, t + 80, len - 80, main, v);
        } else {
            one(ref tw, ch, t, len, main, v);
        }
    }
}

/// One bar of the accompaniment (loot_editions.js: the spread chords, sorted).
#[inline(never)]
fn accomp_bar(ref tw: TrackWriter, k: Box<Ctx>, tok: u32, kind: u32, b: u32, t: u32, ref fast: u32) {
    let c = k.unbox();
    let (v0, p0, p1, p2) = voicing(k, tok);
    let how = spread_of(
        c.spread_seed, *[20_u32, 35, 50].span().at(c.spread_share), c.spread_lean, kind, b,
    );
    let low: felt252 = if c.acc_down {
        -12
    } else {
        0
    };
    let seventh = if sev(tok) {
        Option::Some(pt(c.base, c.home, v0 + 6, tok))
    } else {
        Option::None
    };
    let mut ev: Array<u64> = array![];
    let acc = c.accomp;
    let (bar, spread_seed, octave) = (c.bar, c.spread_seed, c.octave);
    let key = kind * 16 + b;
    let mut j: u32 = opaque(0);
    while j < acc.len() {
        let (off, d, voice, dv) = fig(*acc.at(j));
        let room = room_of(acc, j, off, bar);
        let chord = voice >= 9;
        let mut step = if how >= 3 && chord {
            spread_step(spread_seed, kind, b, room)
        } else {
            0
        };
        // thirty-seconds in one bar of one tune at most
        if step == 60 && fast != key {
            if (spread_seed / 0x100000) % 4 == 0 && fast == NO_FAST {
                fast = key;
            } else {
                step = if room >= 240 {
                    120
                } else {
                    0
                };
            }
        }
        let ps = voices(voice, p0, p1, p2, seventh, low, octave);
        spread_chord(ref ev, if chord {
            how
        } else {
            0
        }, t + off, d, room, ps, 72 + dv, step);
        j += 1;
    }
    ev_write(ref tw, 2, ev.span());
}

/// A walking line (WALKS[raw + 6]) for bar `b` of a tune whose root moves by `raw` steps.
fn walk_line(raw: felt252, seed: u32, b: u32) -> Span<felt252> {
    let at: u32 = (raw + 6).try_into().unwrap();
    let v = *WALKS.span().at(at);
    let n = if v >= 0x10000 {
        2
    } else {
        1
    };
    let mut x = if mix(seed, b) % n == 0 {
        v % 0x10000
    } else {
        v / 0x10000
    };
    let mut out: Array<felt252> = array![];
    for _ in 0..4_u32 {
        out.append(f(x % 16) - 8);
        x /= 16;
    }
    out.span()
}

/// The source's `put`: bar `pb`'s notes at offsets `offs` above its root, lengths `durs`.
#[inline(never)]
fn walk_put(
    ref tw: TrackWriter,
    k: Box<Ctx>,
    chords: Span<u32>,
    t0: u32,
    pb: u32,
    offs: Span<felt252>,
    durs: Span<u32>,
) {
    let c = k.unbox();
    let tok = *chords.at(pb);
    let r = deg(tok);
    let mut t = t0 + pb * c.bar;
    let mut beat: u32 = opaque(0);
    while beat < offs.len() {
        let len = *durs.at(beat);
        let cut = if c.bass_mode == 2 {
            len / 4
        } else {
            30
        };
        let v = if beat == 0 {
            98
        } else {
            88
        };
        one(ref tw, 3, t, f(len - cut), pt(c.base - 24, c.home, r + *offs.at(beat), tok), v);
        t += len;
        beat += 1;
    }
}

/// A tune's walking bass (loot_editions.js walkBass), written from tick `t0`; `next` is the next
/// tune's first root (none at the end).
#[inline(never)]
fn walk_section(
    ref tw: TrackWriter, k: Box<Ctx>, chords: Span<u32>, next: Option<felt252>, t0: u32, seed: u32,
) {
    let c = k.unbox();
    let s = c.s.unbox();
    let (num, den) = (s.num, s.den);
    let mut b: u32 = opaque(0);
    while b < 8 {
        let root = deg(*chords.at(b));
        let to = if b + 1 < 8 {
            Option::Some(deg(*chords.at(b + 1)))
        } else {
            next
        };
        match to {
            Option::None => { walk_put(ref tw, k, chords, t0, b, [0].span(), [c.bar].span()); },
            Option::Some(to) => {
                if num == 2 && den == 4 {
                    let to2 = if b + 2 < 8 {
                        Option::Some(deg(*chords.at(b + 2)))
                    } else {
                        next
                    };
                    let pair = b % 2 == 0 && b + 1 < 8 && deg(*chords.at(b + 1)) == root;
                    if pair && to2.is_some() {
                        let w = walk_line(to2.unwrap() - root, seed, b);
                        walk_put(ref tw, k, chords, t0, b, w.slice(0, 2), [480, 480].span());
                        walk_put(ref tw, k, chords, t0, b + 1, w.slice(2, 2), [480, 480].span());
                        b += 1;
                    } else {
                        let w = walk_line(to - root, seed, b);
                        walk_put(
                            ref tw, k, chords, t0, b, [*w.at(0), *w.at(3)].span(), [480, 480].span(),
                        );
                    }
                } else {
                    let w = walk_line(to - root, seed, b);
                    let (offs, durs) = if den == 8 {
                        (w, [480, 240, 480, 240].span())
                    } else if num == 3 {
                        ([*w.at(0), *w.at(2), *w.at(3)].span(), [480, 480, 480].span())
                    } else {
                        (w, [480, 480, 480, 480].span())
                    };
                    walk_put(ref tw, k, chords, t0, b, offs, durs);
                }
            },
        }
        b += 1;
    }
}

/// One bar of the bass figure (role 3), the pad (4) or the drums (9).
#[inline(never)]
fn rhythm_bar(ref tw: TrackWriter, k: Box<Ctx>, role: u32, tok: u32, b: u32, t: u32, ending: u32) {
    let c = k.unbox();
    let (base, home, bar) = (c.base, c.home, c.bar);
    if role == 3 {
        let bass_base = base - 24;
        let ch = deg(tok);
        for x in c.bass {
            let (off, d, tone, dv) = fig(*x);
            let ps = if tone == 4 {
                array![pitch(bass_base, home, 0), pitch(bass_base, home, 4)]
            } else {
                array![pt(bass_base, home, ch + *[0, -3, 4, 7].span().at(tone), tok)]
            };
            let v = 96 + dv;
            if c.bass_mode == 1 {
                block(ref tw, 3, t + off, f(d / 2) - 10, ps.span(), v);
                block(ref tw, 3, t + off + d / 2, f(d / 2) - 10, ps.span(), v);
            } else {
                let len = if c.bass_mode == 2 {
                    d / 2
                } else {
                    d
                };
                block(ref tw, 3, t + off, f(len), ps.span(), v);
            }
        }
    } else if role == 4 {
        if b % 2 == 0 {
            pad_chord(ref tw, k, tok, t, f(2 * bar) - 40, 46);
        }
    } else {
        let half = bar / 2;
        if ending != 2 {
            for x in c.perc {
                let x = *x;
                let off = x % 2048;
                if ending == 0 || off < half {
                    one(ref tw, 9, t + off, 120, f((x / 2048) % 128), 36 + f(x / 0x40000));
                }
            }
        }
        if ending == 1 {
            drum_fill(ref tw, t + half, half / 120, 68, 28);
        }
    }
}

/// The track of part `role` on channel `ch` with `program`, over the intro and the four tunes.
#[inline(never)]
fn part(k: Box<Ctx>, role: u32, ch: u8, program: u32) -> Array<u8> {
    let c = k.unbox();
    let mut tw = channel_track(ch, program, @c);
    if c.intro.bars > 0 {
        intro(ref tw, k, role);
    }
    let bar = c.bar;
    let mut t0 = c.intro_ticks;
    let mut fast: u32 = opaque(NO_FAST);
    let mut sec: u32 = opaque(0);
    while sec < 4 {
        let kind = *c.kinds.at(sec);
        let chords = *c.nums.at(kind);
        if role == 0 || role == 1 || role == 5 || role == 7 {
            let plain = sec < 3 && *c.kinds.at(sec + 1) == kind;
            let m = if sec == 3 {
                c.last_mel
            } else {
                *c.mels.at(kind)
            };
            lead_section(ref tw, k, role, m, chords, t0, kind, *c.doubled.at(sec), plain);
        } else {
            let walks = role == 3 && (c.walk_tunes / *[1_u32, 2, 4, 8].span().at(sec)) % 2 == 1;
            if walks {
                let next = if sec < 3 {
                    Option::Some(deg(*(*c.nums.at(*c.kinds.at(sec + 1))).at(0)))
                } else {
                    Option::None
                };
                walk_section(ref tw, k, chords, next, t0, mix(mix(c.walk_seed, sec), c.month));
            } else {
                let mut b: u32 = opaque(0);
                while b < 8 {
                    let t = t0 + b * bar;
                    let tok = *chords.at(b);
                    if role == 2 {
                        accomp_bar(ref tw, k, tok, kind, b, t, ref fast);
                    } else {
                        let ending = if b == 7 {
                            *c.drum_ends.at(sec)
                        } else {
                            0
                        };
                        rhythm_bar(ref tw, k, role, tok, b, t, ending);
                    }
                    b += 1;
                }
            }
        }
        t0 += 8 * bar;
        sec += 1;
    }
    tw.finish_at(t0)
}

/// Edition `e`'s style index, its tables and its tempo (e >= 1).
#[inline(never)]
pub fn edition_genome(e: u32) -> (u32, Box<Style>, u32) {
    assert(e >= 1, 'editions start at 1');
    let st = (e - 1) % STYLE_COUNT;
    let sb = style(st);
    let s = sb.unbox();
    let pass = (e - 1) / STYLE_COUNT;
    let bpm = s.bpm_lo + (pass * 7 + st * 3) % (s.bpm_hi - s.bpm_lo + 1);
    (st, sb, bpm)
}

#[inline(never)]
fn kind_of(form: u32, sec: u32) -> u32 {
    (form / *[1_u32, 4, 16, 64].span().at(sec)) % 4
}

/// The parts' order: a shuffle of descant, bass, pad, percussion (bits).
#[inline(never)]
fn part_order(ref r: Rng) -> Span<u32> {
    let (mut order, mut x): (Array<u32>, u32) = opaque((array![DESCANT, BASS, PAD, PERC], 3));
    while x > 0 {
        let j = r.int(x + 1);
        let o = order.span();
        let mut next: Array<u32> = array![];
        for y in 0..4_u32 {
            next.append(*o.at(if y == x {
                j
            } else if y == j {
                x
            } else {
                y
            }));
        }
        order = next;
        x -= 1;
    }
    order.span()
}

/// The A' tune: A's first four bars and a fresh tune's last four (`fresh`), or A decorated (each
/// note of a quarter or longer split, its second half a step toward the next note).
#[inline(never)]
fn a_prime(mel_a: Span<Note>, fresh: Option<Span<Note>>, half: u32) -> Span<Note> {
    let mut out: Array<Note> = array![];
    match fresh {
        Option::Some(fresh) => {
            for n in mel_a {
                if half > n.t {
                    out.append(*n);
                }
            }
            for n in fresh {
                if n.t >= half {
                    out.append(*n);
                }
            }
        },
        Option::None => {
            let mut y: u32 = opaque(0);
            while y < mel_a.len() {
                let n = *mel_a.at(y);
                if n.len < 480 || y + 1 == mel_a.len() {
                    out.append(n);
                } else {
                    let nd = (*mel_a.at(y + 1)).d;
                    let h = n.len / 2;
                    out.append(Note { t: n.t, len: h, d: n.d });
                    let d = if nd < n.d {
                        n.d - 1
                    } else {
                        n.d + 1
                    };
                    out.append(Note { t: n.t + h, len: n.len - h, d });
                }
                y += 1;
            }
        },
    }
    out.span()
}

/// The tempo track: Set Tempo (the day's knob may nudge it) and the time signature.
#[inline(never)]
fn tempo_track(bpm: u32, knob: u8, delta: i64, num: u32, den: u32, ticks: u32) -> Array<u8> {
    let mut us = (120000000 + bpm) / (2 * bpm);
    if knob >= 2 && knob <= 5 {
        let x = nudge_tempo(us, delta);
        us = if x > MAX_TEMPO_US {
            MAX_TEMPO_US
        } else {
            x
        };
    }
    let mut tempo = TrackWriterTrait::new();
    tempo.tempo(0, us);
    let den_log: u8 = if den == 8 {
        3
    } else {
        2
    };
    tempo.meta(0, 0x58, [num.try_into().unwrap(), den_log, 24, 8].span());
    tempo.finish_at(ticks)
}

/// The harp glissando's track (channel 6): into the end of tune `plan.spot`, in its last chord's
/// colour, over its last half bar (a bar of 2/4, 720 ticks in 6/8).
#[inline(never)]
fn gliss_track(
    k: Box<Ctx>, plan: GlissPlan, seed: u32, program: u32, ticks: u32, bpm: u32,
) -> Array<u8> {
    let c = k.unbox();
    let s = c.s.unbox();
    let (bar, sec) = (c.bar, plan.spot);
    let t0 = c.intro_ticks + (sec + 1) * 8 * bar;
    let tok = *(*c.nums.at(*c.kinds.at(sec))).at(7);
    let span = if s.den == 8 {
        720
    } else if bar < 960 {
        bar
    } else {
        960
    };
    let last = if sec == 3 {
        t0
    } else {
        t0 + 480
    };
    let mut ev: Array<u64> = array![];
    for n in glissando(plan, t0, span, seed, last, bpm) {
        let p: u32 = pt(c.base, c.home, n.d.into(), tok).try_into().unwrap();
        ev_push(ref ev, n.t, true, p, n.v);
        ev_push(ref ev, n.t + n.len, false, p, 0);
    }
    let mut tw = channel_track(GLISS_CHANNEL, program, @c);
    ev_write(ref tw, GLISS_CHANNEL, ev.span());
    tw.finish_at(ticks)
}

/// The purchase's draws from its main stream (R), the month's and the week's drift applied.
#[derive(Copy, Drop)]
struct Main {
    r: Rng,
    tonic: u32,
    bpm: u32,
    pa: u32,
    pb: u32,
    pc: u32,
    form_id: u32,
    acc_i: u32,
    bass_i: u32,
    perc_i: u32,
    theme: u32,
    orn: u32,
    orn_seed: u32,
    detached: bool,
    orn_kind: u32,
    roll: u32,
    bass_mode: u32,
    parts: u32,
    rot: u32,
}

#[inline(never)]
fn main_draws(
    s: Box<Style>,
    g_bpm: u32,
    tonic_pc: u32,
    tier: u8,
    mut r: Rng,
    tp: Rng,
    month: Option<u32>,
    rotate: Option<u32>,
    knob: u8,
    day: u64,
) -> Box<Main> {
    let s = s.unbox();
    let mut tonic = (tonic_pc + *[0_u32, 0, 0, 5, 7, 10, 2, 3].span().at(r.int(8))) % 12;
    let quicker = if s.bpm_hi <= SLOW_TOP {
        let mut tp = tp;
        *QUICKER.span().at(tp.int(9))
    } else {
        0
    };
    let b0 = g_bpm + *[0_u32, 2, 4, 4, 6, 8].span().at(r.int(6)) - 4;
    let bpm = (b0 * (100 + quicker) + 50) / 100;
    let mut pa = r.int(64);
    let mut pb = r.int(64);
    if pb == pa {
        pb = (pa + 1) % 64;
    }
    let mut pc = (pa + 1 + r.int(62)) % 64;
    if pc == pb {
        pc = (pc + 1) % 64;
    }
    if knob == 0 {
        let x = pa;
        pa = pb;
        pb = x;
    }
    r.int(s.n_modes);
    let mut form_id = r.int(8);
    let mut acc_i = r.int(4);
    let bass_i = r.int(3);
    let mut perc_i = r.int(2);
    if let Option::Some(m) = month {
        acc_i = (acc_i + 1 + m % 3) % 4;
        perc_i = (perc_i + 1) % 2;
        form_id = (form_id + 1 + (m / 64) % 3) % 8;
        let km = (m / 256) % 3;
        if km < 2 {
            tonic = (tonic + 7 - 2 * km) % 12;
        }
    }
    let theme = r.int(4);
    let mut orn = *[0_u32, 0, 15, 30].span().at(r.int(4));
    let orn_seed = r.int(100);
    let detached = (r.int(2) == 1) != (knob >= 2 && knob <= 5);
    let mut orn_kind = orn_seed % 4;
    let roll = r.int(100);
    let mut bass_mode = roll % 3;
    let mut count = if roll < 20 {
        1
    } else if roll < 60 {
        2
    } else if roll < 88 {
        3
    } else {
        4
    };
    if tier <= 2 && count < 4 {
        count += 1;
    }
    let order = part_order(ref r);
    let mut parts: u32 = opaque(0);
    for y in order.slice(0, count) {
        parts += *y;
    }
    let mut rot: u32 = 0;
    if let Option::Some(h) = rotate {
        if count == 4 {
            parts -= *order.at(h % 4);
        } else {
            parts = parts - *order.at(h % count) + *order.at(count + (h / 4) % (4 - count));
        }
        rot = 1 + (h / 16) % 2;
        orn_kind = (orn_kind + 1 + (h / 32) % 3) % 4;
        let dd: u32 = (day / 180).try_into().unwrap_or(1000);
        let ceiling = if dd < 2 {
            2 + dd
        } else {
            4
        };
        orn = *[0_u32, 15, 30, 45, 60].span().at((h / 128) % (ceiling + 1));
        bass_mode = (bass_mode + 1 + (h / 512) % 2) % 3;
    }
    BoxTrait::new(
        Main {
            r,
            tonic,
            bpm,
            pa,
            pb,
            pc,
            form_id,
            acc_i,
            bass_i,
            perc_i,
            theme,
            orn,
            orn_seed,
            detached,
            orn_kind,
            roll,
            bass_mode,
            parts,
            rot,
        },
    )
}

/// The draws of the purchase's other streams (each its own, so the main draws stay as they were),
/// the drift applied.
#[derive(Copy, Drop)]
struct Side {
    walk_tunes: u32,
    walk_seed: u32,
    spread_share: u32,
    spread_lean: u32,
    spread_seed: u32,
    acc_low: bool,
    gl_draw: u32,
    gl_seed: u32,
    alt_kind: u32,
    doubled: Span<felt252>,
    any_doubled: bool,
    drum_ends: Span<u32>,
    intro: Intro,
}

#[inline(never)]
fn side_draws(
    fold: u32,
    e: u32,
    id: u32,
    month: Option<u32>,
    rotate: Option<u32>,
    kinds: Span<u32>,
    form_id: u32,
    num: u32,
    den: u32,
    bpm: u32,
) -> Box<Side> {
    // the walking bass (WK): three purchases in five, for the second half, the last tune or the
    // third tune
    let mut wk = stream(fold, e, id, 0x51ed270b, 0x2f0b4a13);
    let mut walking = wk.int(5) < 3;
    let walk_seed = wk.next();
    let mut walk_span = wk.int(4);
    // the spread chords (SP) and the accompaniment an octave lower
    let mut spr = stream(fold, e, id, 0x2545f491, 0x61c88647);
    let mut spread_share = spr.int(3);
    let mut spread_lean = spr.int(3);
    let mut spread_seed = spr.next();
    if let Option::Some(m) = month {
        spread_seed = mix(spread_seed, m);
    }
    let mut acc_low = spr.int(3) == 0;
    // the glissando (GL)
    let mut gl = stream(fold, e, id, 0x7feb352d, 0x846ca68b);
    let gl_draw = gl.int(20);
    let mut gl_seed = gl.next();
    if let Option::Some(h) = rotate {
        if (h / 16384) % 4 == 0 {
            walking = !walking;
        }
        walk_span = (walk_span + (h / 65536) % 4) % 4;
        spread_share = (spread_share + 1 + (h / 2048) % 2) % 3;
        spread_lean = (spread_lean + 1 + (h / 4096) % 2) % 3;
        if (h / 8192) % 2 == 1 {
            acc_low = !acc_low;
        }
        gl_seed = mix(gl_seed, h);
    }
    // the second lead (AL): the C tune when there is one (half the time), else a B tune (every
    // form has one)
    let mut al = stream(fold, e, id, 0x7ed55d16, 0x165667c5);
    let alt_draw = al.int(5) < 2;
    let alt_c = al.int(2) == 0;
    let alt_kind = if !alt_draw {
        NO_KIND
    } else if form_id % 4 == 3 && alt_c {
        2
    } else {
        1
    };
    // the doubled repeats (DB)
    let mut db = stream(fold, e, id, 0x3c6ef372, 0x1b873593);
    let mut doubled: Array<felt252> = array![0];
    let mut any_doubled = false;
    let mut y: u32 = opaque(1);
    while y < 4 {
        let dv = if *kinds.at(y) == *kinds.at(y - 1) && (db.int(2) == 0 || db.int(5) < 3) {
            any_doubled = true;
            *[2, -3, -4].span().at(db.int(3))
        } else {
            0
        };
        doubled.append(dv);
        y += 1;
    }
    // the drums' tune endings (DF): a fill 7 in 20, a cut 5 in 20
    let mut df = stream(fold, e, id, 0x2c1b3c6d, 0x297a2d39);
    let mut drum_ends: Array<u32> = array![];
    let mut y: u32 = opaque(0);
    while y < 4 {
        let x = df.int(20);
        drum_ends.append(if x < 7 {
            1
        } else if x < 12 {
            2
        } else {
            0
        });
        y += 1;
    }
    // the intro (IN)
    let mut inr = stream(fold, e, id, 0x6a09e667, 0x3c6ef35f);
    let mut bars = if inr.int(2) == 0 {
        1 + inr.int(4)
    } else {
        0
    };
    let in_kind = inr.int(4);
    let up = inr.int(3) > 0;
    let answer = *[-3, 2, -5].span().at(inr.int(3));
    let mirror = inr.int(2) == 0;
    let counter = inr.int(3) > 0;
    let run = inr.int(4) == 0;
    let arp = in_kind == 3 && inr.int(2) == 0;
    if bars == 1 && num == 2 {
        bars = 2;
    }
    // at most INTRO_MAX_S (4.5) seconds at the track's tempo, never under one bar (two in 2/4):
    // floor(4.5 / (num * (4 / den) * 60 / bpm)) exactly (scripts/intro_max_check.mjs checks the source's
    // float form agrees wherever it matters, under 4)
    if bars != 0 {
        let cap = (3 * bpm * den) / (160 * num);
        let least = if num == 2 {
            2
        } else {
            1
        };
        if cap < bars {
            bars = cap;
        }
        if bars < least {
            bars = least;
        }
    }
    BoxTrait::new(
        Side {
            walk_tunes: if walking {
                *[12_u32, 12, 8, 4].span().at(walk_span)
            } else {
                0
            },
            walk_seed,
            spread_share,
            spread_lean,
            spread_seed,
            acc_low,
            gl_draw,
            gl_seed,
            alt_kind,
            doubled: doubled.span(),
            any_doubled,
            drum_ends: drum_ends.span(),
            intro: Intro { bars, up, answer, mirror, counter, run, arp },
        },
    )
}

/// The four tunes' chords (stream H) and melodies (the main stream, or the month's).
#[inline(never)]
fn tunes(
    sb: Box<Style>, mm: Box<Main>, motif: Span<i32>, kinds: Span<u32>, mut mr: Rng, hh: Rng,
) -> (Span<Span<u32>>, Span<Span<Note>>) {
    let s = sb.unbox();
    let m = mm.unbox();
    let mut hh = hh;
    let last_kind = *kinds.at(3);
    let p_of = [m.pa, m.pb, m.pc, m.pa].span();
    let mut nums: Array<Span<u32>> = array![];
    let mut kk: u32 = opaque(0);
    while kk < 4 {
        nums.append(section_chords(sb, *p_of.at(kk), kk != 1 || last_kind == 1, ref hh));
        kk += 1;
    }
    let nums = nums.span();
    let bar = s.num * (1920 / s.den);
    let strong2 = if s.den == 8 {
        720
    } else if s.num == 4 {
        960
    } else {
        0
    };
    let ma = BoxTrait::new(Mel { bar, strong2, lo: -1, motif });
    let mb = BoxTrait::new(Mel { bar, strong2, lo: 1, motif: [].span() });
    let mel_a = melody(s.cells, s.end, ma, *nums.at(0), true, ref mr);
    let mel_b = melody(s.cells, s.end, mb, *nums.at(1), last_kind == 1, ref mr);
    let mel_c = if m.form_id % 4 == 3 {
        melody(s.cells, s.end, mb, *nums.at(2), true, ref mr)
    } else {
        [].span()
    };
    let mel_d = if m.form_id < 4 {
        [].span()
    } else if (m.orn_seed / 4) % 2 == 0 {
        a_prime(mel_a, Option::Some(melody(s.cells, s.end, ma, *nums.at(0), true, ref mr)), 4 * bar)
    } else {
        a_prime(mel_a, Option::None, 0)
    };
    (nums, [mel_a, mel_b, mel_c, mel_d].span())
}

/// The last tune when the form ends on A or A' (`grand`): every note GRAND_STEP (2) scale steps
/// higher, those on strong beats and the long ones snapped onto the bar's chord, the last the upper
/// tonic.
#[inline(never)]
fn grand(m: Span<Note>, chords: Span<u32>, bar: u32, strong2: u32) -> Span<Note> {
    let mut out: Array<Note> = opaque(array![]);
    let n = m.len();
    let mut i: u32 = opaque(0);
    while i != n {
        let x = *m.at(i);
        let d2: felt252 = x.d.into() + 2;
        let d: felt252 = if i + 1 == n {
            7
        } else if strong(x.t, bar, strong2) || x.len >= 720 {
            d2 + (*SNAP.span().at(m7(d2 - deg(*chords.at(x.t / bar))))).into()
        } else {
            d2
        };
        out.append(Note { t: x.t, len: x.len, d: d.try_into().unwrap() });
        i += 1;
    }
    out.span()
}

/// Everything the tracks read.
#[derive(Copy, Drop)]
struct Plan {
    ctx: Box<Ctx>,
    bpm: u32,
    ticks: u32,
    parts: u32,
    any_doubled: bool,
    lead_p: u32,
    acc_p: u32,
    gl_draw: u32,
    gl_seed: u32,
}

#[inline(never)]
fn plan(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>, band: Span<u8>,
) -> Box<Plan> {
    let (month, rotate, knob, day) = match drift {
        Option::Some(d) => (
            match d.rhythm {
                Option::Some(h) => Option::Some(low32(h)),
                Option::None => Option::None,
            },
            match d.rotate {
                Option::Some(h) => Option::Some(low32(h)),
                Option::None => Option::None,
            },
            d.day_knob,
            d.day,
        ),
        Option::None => (Option::None, Option::None, 6, 0),
    };
    let sp = loot_species(species);
    let (style, sb, g_bpm) = edition_genome(e);
    let s = sb.unbox();
    let id = species;
    let ty: u32 = sp.beast_type.into();
    let fold = fold64(seed);
    let mm = main_draws(
        sb,
        g_bpm,
        sp.tonic_pc.into(),
        sp.tier,
        stream(fold, e, id, 0x9e3779b1, 0x85ebca77),
        stream(fold, e, id, 0x5bd1e995, 0x1b56c4e9),
        month,
        rotate,
        knob,
        day,
    );
    let m = mm.unbox();
    let form = *FORMS.span().at(m.form_id);
    let kinds = [kind_of(form, 0), kind_of(form, 1), kind_of(form, 2), kind_of(form, 3)].span();
    let sd = side_draws(fold, e, id, month, rotate, kinds, m.form_id, s.num, s.den, m.bpm);
    let side = sd.unbox();
    // the theme as the A tune opens with it: as written, inverted, reversed or a third up
    let mut motif: Array<i32> = array![];
    for y in 0..6_u32 {
        let d: i32 = (*sp.degrees.span().at(if m.theme == 2 {
            5 - y
        } else {
            y
        }))
            .into();
        motif.append(if m.theme == 1 {
            -d
        } else if m.theme == 3 {
            d + 2
        } else {
            d
        });
    }
    let mr = match month {
        Option::Some(x) => RngTrait::new(x),
        Option::None => m.r,
    };
    let (nums, mels) = tunes(
        sb, mm, motif.span(), kinds, mr, stream(fold, e, id, 0x27d4eb2d, 0x165667b1),
    );
    let mel_a = *mels.at(0);
    let bar = s.num * (1920 / s.den);
    // the palette: lead, counter, accompaniment, bass, pad for this beast type
    let pal = s.palette;
    let mut lead_p = *pal.at(ty);
    if mega {
        lead_p = *MEGA_LEADS.span().at(id % 2);
    } else if lead_p == 47 && (m.orn_seed + m.roll) % 4 != 0 {
        lead_p = *pal.at(3 + ty);
    }
    let acc_p = *pal.at(6 + ty);
    let acc_down = (acc_p == 99 && (m.orn_seed / 8) % 3 == 0)
        || (side.acc_low && (s.flags / 4) % 2 == 1);
    let intro_ticks = side.intro.bars * bar;
    let mels = if knob == 1 {
        [*mels.at(1), mel_a, *mels.at(2), *mels.at(3)].span()
    } else {
        mels
    };
    // the last tune a third higher when the form ends on A or A'
    let last_kind = *kinds.at(3);
    let last_mel = if last_kind == 0 || last_kind == 3 {
        let strong2 = if s.den == 8 {
            720
        } else if s.num == 4 {
            960
        } else {
            0
        };
        grand(*mels.at(last_kind), *nums.at(last_kind), bar, strong2)
    } else {
        *mels.at(last_kind)
    };
    // the accompaniment's octave doubling below the root: one purchase in three (its own stream)
    let mut ob = stream(fold, e, id, 0x4cf5ad43, 0x2745937f);
    let octave: felt252 = if ob.int(3) < 1 && !acc_down {
        -12
    } else {
        12
    };
    let ctx = BoxTrait::new(
        Ctx {
            s: sb,
            style,
            base: f(if m.tonic < 6 {
                60 + m.tonic
            } else {
                48 + m.tonic
            }),
            home: *SCALES.span().at(s.mode),
            bar,
            rot: m.rot,
            parts: m.parts,
            acc_down,
            octave,
            detached: m.detached,
            accomp: *s.accomps.at(m.acc_i),
            bass: *s.basses.at(m.bass_i),
            perc: *s.percs.at(m.perc_i),
            bass_mode: m.bass_mode,
            orn: m.orn,
            orn_seed: m.orn_seed,
            orn_kind: m.orn_kind,
            alt_kind: side.alt_kind,
            intro: side.intro,
            intro_ticks,
            spread_share: side.spread_share,
            spread_lean: side.spread_lean,
            spread_seed: side.spread_seed,
            flags: s.flags,
            kinds,
            nums,
            mels,
            mel_a,
            last_mel,
            doubled: side.doubled,
            drum_ends: side.drum_ends,
            walk_tunes: side.walk_tunes,
            walk_seed: side.walk_seed,
            month: match month {
                Option::Some(x) => x,
                Option::None => 0,
            },
            band,
        },
    );
    BoxTrait::new(
        Plan {
            ctx,
            bpm: m.bpm,
            ticks: intro_ticks + 32 * bar,
            parts: m.parts,
            any_doubled: side.any_doubled,
            lead_p,
            acc_p,
            gl_draw: side.gl_draw,
            gl_seed: side.gl_seed,
        },
    )
}

/// The track bodies of edition `e` for Loot Beast `species` (species.cairo ids), mega or not, a
/// purchase seed and an optional day of drift: the tempo track, the lead, the descant, the
/// accompaniment, the bass, pad and percussion when they play, the mega double, the glissando and
/// the second lead, as loot_editions.js editionTrack.
pub fn edition_tracks(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>,
) -> Array<Array<u8>> {
    edition_tracks_played(species, mega, e, seed, drift, array![].span())
}

/// `edition_tracks` with each pitched channel's program change set to `band[ch % band.len()]`
/// (empty: as written): the file `orchestra::orchestrate` would make, written that way directly.
pub fn edition_tracks_played(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>, band: Span<u8>,
) -> Array<Array<u8>> {
    let p = plan(species, mega, e, seed, drift, band).unbox();
    let (knob, delta) = match drift {
        Option::Some(d) => (d.day_knob, d.delta_bpm),
        Option::None => (6, 0),
    };
    let ctx = p.ctx;
    let c = ctx.unbox();
    let s = c.s.unbox();
    let ty: u32 = loot_species(species).beast_type.into();
    let (parts, ticks, acc_p) = (p.parts, p.ticks, p.acc_p);
    let mut tracks: Array<Array<u8>> = array![
        tempo_track(p.bpm, knob, delta, s.num, s.den, ticks), part(ctx, 0, 0, p.lead_p),
    ];
    if parts & DESCANT != 0 || p.any_doubled {
        tracks.append(part(ctx, 1, 1, p.lead_p));
    }
    tracks.append(part(ctx, 2, 2, acc_p));
    if parts & BASS != 0 {
        tracks.append(part(ctx, 3, 3, *s.palette.at(9 + ty)));
    }
    if parts & PAD != 0 {
        tracks.append(part(ctx, 4, 4, *s.palette.at(12 + ty)));
    }
    if parts & PERC != 0 {
        tracks.append(part(ctx, 9, 9, 0));
    }
    if mega {
        tracks.append(part(ctx, 5, 5, *MEGA_LEADS.span().at((species + 1) % 2)));
    }
    if let Option::Some(gp) = gliss_plan(p.gl_draw, p.gl_seed, [3, 3, 1, 0, 2].span()) {
        tracks.append(gliss_track(ctx, gp, p.gl_seed, acc_p, ticks, p.bpm));
    }
    if c.alt_kind != NO_KIND {
        tracks.append(part(ctx, 7, ALT_CHANNEL, acc_p));
    }
    tracks
}

/// Edition `e`'s track as a Standard MIDI File (format 1, 480 ticks per quarter note):
/// loot_editions.js `editionMidi(species, mega, e, seed, drift).midi`.
pub fn edition_smf_bytes(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>,
) -> Array<u8> {
    smf_bytes(1, 480, edition_tracks(species, mega, e, seed, drift).span())
}

/// The same as a `ByteArray`.
pub fn edition_byte_array(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>,
) -> ByteArray {
    smf_byte_array(1, 480, edition_tracks(species, mega, e, seed, drift).span())
}

/// The edition as the lab plays it, packed for a contract: band instruments written in place.
pub fn edition_played_byte_array(
    species: u32, mega: bool, e: u32, seed: u64, drift: Option<Drift>, band: Span<u8>,
) -> ByteArray {
    smf_byte_array(1, 480, edition_tracks_played(species, mega, e, seed, drift, band).span())
}
