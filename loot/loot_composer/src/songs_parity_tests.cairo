fn sum(xs: Span<u8>) -> u32 {
    let mut h: u32 = 0;
    for b in xs {
        h = core::num::traits::WrappingAdd::wrapping_add(core::num::traits::WrappingMul::wrapping_mul(h, 31), (*b).into());
    }
    h
}

fn check(species: u32, mega: bool, name: u16, clock: Option<DriftClock>, len: u32, s: u32, plen: u32, ps: u32, lift: u8) {
    let midi = song_bytes(species, mega, name, clock);
    assert_eq!(midi.len(), len);
    assert_eq!(sum(midi.span()), s);
    let drift = match clock {
        Option::Some(c) => Option::Some(layered_drift(species.into(), 0, 0, c)),
        Option::None => Option::None,
    };
    let b = song_band(loot_species(species).beast_type, species, name.into(), drift);
    let kick = if name == 0 { 0 } else { crate::orchestra_data::NAME_KICK_SOFT };
    let played = orchestrate(midi.span(), b.span(), lift, song_vols(b.span(), name != 0).span(), kick);
    let played = if has_soft(b.span()) {
        match top_soft_smf(played.span(), b.span()) {
            Option::Some(x) => x,
            Option::None => played,
        }
    } else {
        played
    };
    assert_eq!(played.len(), plen);
    assert_eq!(sum(played.span()), ps);
}

