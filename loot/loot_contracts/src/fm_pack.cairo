//! LootFmPack: the Loot FM sound pack onchain. The pack is one self-contained script
//! (offchain/fm/dist/loot-fm-pack.min.js: the Kankyo FM instruments' engine, sampler and patch data; it renders
//! every instrument in the browser when it loads), gzip-compressed and stored as base64 text in this class's
//! code (fm_pack_data.cairo, generated by offchain/fm/pack/cairo.mjs; Cairo string literals hold ASCII only,
//! and base64 is what a page needs anyway). No storage, no constructor arguments.
//!
//! A page reads `pack()` (or the chunks, for clients that cap a call's return size), decodes the base64,
//! gunzips it (`DecompressionStream('gzip')`) and runs the script; see offchain/fm/README.md.

#[starknet::interface]
pub trait ILootFmPack<TState> {
    /// The pack format's version (the script's API, offchain/fm/README.md).
    fn version(self: @TState) -> u32;
    /// 'gzip+base64': how `pack()` is encoded.
    fn encoding(self: @TState) -> felt252;
    /// Length of `pack()` in bytes (base64 characters).
    fn pack_len(self: @TState) -> u32;
    /// Length of the gzip bytes the base64 decodes to.
    fn gzip_len(self: @TState) -> u32;
    /// Length of the script once gunzipped.
    fn script_len(self: @TState) -> u32;
    /// sha256 of `pack()`.
    fn pack_sha256(self: @TState) -> u256;
    /// The whole pack: base64 of the gzip bytes of the script.
    fn pack(self: @TState) -> ByteArray;
    /// The pack in `chunk_count()` pieces of `chunk_len()` bytes (the last shorter); joined they are `pack()`,
    /// and each is a multiple of 4 characters, so base64 on its own.
    fn chunk_count(self: @TState) -> u32;
    fn chunk_len(self: @TState) -> u32;
    fn chunk(self: @TState, index: u32) -> ByteArray;
}

#[starknet::contract]
pub mod LootFmPack {
    use crate::fm_pack_data as data;

    #[storage]
    struct Storage {}

    #[abi(embed_v0)]
    impl LootFmPackImpl of super::ILootFmPack<ContractState> {
        fn version(self: @ContractState) -> u32 {
            data::VERSION
        }
        fn encoding(self: @ContractState) -> felt252 {
            'gzip+base64'
        }
        fn pack_len(self: @ContractState) -> u32 {
            data::PACK_LEN
        }
        fn gzip_len(self: @ContractState) -> u32 {
            data::GZIP_LEN
        }
        fn script_len(self: @ContractState) -> u32 {
            data::SCRIPT_LEN
        }
        fn pack_sha256(self: @ContractState) -> u256 {
            data::PACK_SHA256
        }
        fn pack(self: @ContractState) -> ByteArray {
            // every chunk but the last is whole words, so each append copies words as they are
            let mut out = data::chunk(0);
            let mut i: u32 = 1;
            while i < data::CHUNK_COUNT {
                out.append(@data::chunk(i));
                i += 1;
            }
            out
        }
        fn chunk_count(self: @ContractState) -> u32 {
            data::CHUNK_COUNT
        }
        fn chunk_len(self: @ContractState) -> u32 {
            data::CHUNK_LEN
        }
        fn chunk(self: @ContractState, index: u32) -> ByteArray {
            data::chunk(index)
        }
    }
}

#[cfg(test)]
mod tests {
    use core::sha256::compute_sha256_byte_array;
    use snforge_std::fs::{FileParser, FileTrait};
    use snforge_std::{ContractClassTrait, DeclareResultTrait, declare};
    use super::{ILootFmPackDispatcher, ILootFmPackDispatcherTrait};

    fn deploy() -> ILootFmPackDispatcher {
        let class = declare("LootFmPack").unwrap().contract_class();
        let (address, _) = class.deploy(@array![]).unwrap();
        ILootFmPackDispatcher { contract_address: address }
    }

    // data/loot_fm_pack_b64.txt is offchain/fm/dist/loot-fm-pack.min.js.gz.b64 as a serialized ByteArray
    fn dist_file() -> ByteArray {
        FileParser::<ByteArray>::parse_txt(@FileTrait::new("data/loot_fm_pack_b64.txt")).unwrap()
    }

    #[test]
    fn pack_is_the_dist_file() {
        let pack = deploy();
        let bytes = pack.pack();
        let expected = dist_file();
        assert_eq!(bytes.len(), expected.len());
        assert!(bytes == expected, "pack bytes differ from the dist file");
        assert_eq!(bytes.len(), pack.pack_len());
        assert_eq!(pack.encoding(), 'gzip+base64');
        assert_eq!(pack.version(), 1);
        assert_eq!(bytes.len() % 4, 0);
        assert!(pack.gzip_len() * 4 <= bytes.len() * 3 && bytes.len() * 3 < pack.gzip_len() * 4 + 12, "gzip_len");
        // gzip's magic 1f 8b 08 is "H4sI" in base64
        assert_eq!(bytes.at(0).unwrap(), 'H');
        assert_eq!(bytes.at(1).unwrap(), '4');
        assert_eq!(bytes.at(2).unwrap(), 's');
        assert_eq!(bytes.at(3).unwrap(), 'I');
    }

    #[test]
    fn chunks_join_to_the_pack() {
        let pack = deploy();
        let mut joined: ByteArray = "";
        let mut i: u32 = 0;
        while i < pack.chunk_count() {
            let c = pack.chunk(i);
            if i + 1 < pack.chunk_count() {
                assert_eq!(c.len(), pack.chunk_len());
            }
            joined.append(@c);
            i += 1;
        }
        assert!(joined == dist_file(), "chunks differ from the dist file");
        assert_eq!(pack.chunk(pack.chunk_count()).len(), 0);
    }

    #[test]
    fn sha256_matches() {
        let pack = deploy();
        let [a, b, c, d, e, f, g, h] = compute_sha256_byte_array(@pack.pack());
        let high: u128 = a.into() * 0x1000000000000000000000000 + b.into() * 0x10000000000000000 + c.into() * 0x100000000 + d.into();
        let low: u128 = e.into() * 0x1000000000000000000000000 + f.into() * 0x10000000000000000 + g.into() * 0x100000000 + h.into();
        assert!(u256 { low, high } == pack.pack_sha256(), "sha256 differs");
    }
}
