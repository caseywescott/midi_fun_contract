    let mut o0 = *t[h0];
    o0 = o0 * 0x10000 + *t[l0];
    o0 = o0 * 0x10000 + *t[h1];
    o0 = o0 * 0x10000 + *t[l1];
    o0 = o0 * 0x10000 + *t[h2];
    o0 = o0 * 0x10000 + *t[l2];
    o0 = o0 * 0x10000 + *t[h3];
    o0 = o0 * 0x10000 + *t[l3];
    o0 = o0 * 0x10000 + *t[h4];
    o0 = o0 * 0x10000 + *t[l4];
    o0 = o0 * 0x10000 + *t[h5];
    o0 = o0 * 0x10000 + *t[l5];
    o0 = o0 * 0x10000 + *t[h6];
    o0 = o0 * 0x10000 + *t[l6];
    o0 = o0 * 0x10000 + *t[h7];
    o0 = o0 * 0x100 + *t6[l7a];
    let mut o1 = *t6[l7b];
    o1 = o1 * 0x10000 + *t[h8];
    o1 = o1 * 0x10000 + *t[l8];
    o1 = o1 * 0x10000 + *t[h9];
    o1 = o1 * 0x10000 + *t[l9];
    o1 = o1 * 0x10000 + *t[h10];
    o1 = o1 * 0x10000 + *t[l10];
    o1 = o1 * 0x10000 + *t[h11];
    o1 = o1 * 0x10000 + *t[l11];
    o1 = o1 * 0x10000 + *t[h12];
    o1 = o1 * 0x10000 + *t[l12];
    o1 = o1 * 0x10000 + *t[h13];
    o1 = o1 * 0x10000 + *t[l13];
    o1 = o1 * 0x10000 + *t[h14];
    o1 = o1 * 0x10000 + *t[l14];
    o1 = o1 * 0x10000 + *t[h15];
    let mut o2 = *t[l15];
    o2 = o2 * 0x10000 + *t[h16];
    o2 = o2 * 0x10000 + *t[l16];
    o2 = o2 * 0x10000 + *t[h17];
    o2 = o2 * 0x10000 + *t[l17];
    o2 = o2 * 0x10000 + *t[h18];
    o2 = o2 * 0x10000 + *t[l18];
    o2 = o2 * 0x10000 + *t[h19];
    o2 = o2 * 0x10000 + *t[l19];
    o2 = o2 * 0x10000 + *t[h20];
    o2 = o2 * 0x10000 + *t[l20];
    o2 = o2 * 0x10000 + *t[h21];
    o2 = o2 * 0x10000 + *t[l21];
    o2 = o2 * 0x10000 + *t[h22];
    o2 = o2 * 0x10000 + *t[l22];
    o2 = o2 * 0x100 + *t6[h23a];
    let mut o3 = *t6[h23b];
    o3 = o3 * 0x10000 + *t[l23];
    o3 = o3 * 0x10000 + *t[h24];
    o3 = o3 * 0x10000 + *t[l24];
    o3 = o3 * 0x10000 + *t[h25];
    o3 = o3 * 0x10000 + *t[l25];
    o3 = o3 * 0x10000 + *t[h26];
    o3 = o3 * 0x10000 + *t[l26];
    o3 = o3 * 0x10000 + *t[h27];
    o3 = o3 * 0x10000 + *t[l27];
    o3 = o3 * 0x10000 + *t[h28];
    o3 = o3 * 0x10000 + *t[l28];
    o3 = o3 * 0x10000 + *t[h29];
    o3 = o3 * 0x10000 + *t[l29];
    o3 = o3 * 0x10000 + *t[h30];
    o3 = o3 * 0x10000 + *t[l30];
    (o0, o1, o2, o3)
}

/// Splits a 31-byte word at `p` bytes from the end (1 <= p <= 30): returns (top 31-p bytes, low p
/// bytes).
#[inline(always)]
fn b64_split_word(
    w: felt252, p_lt16: bool, p_eq16: bool, nz_lo: NonZero<u128>, mul_hi: felt252,
) -> (felt252, felt252) {
    let u: u256 = w.into();
    if p_eq16 {
        (u.high.into(), u.low.into())
    } else if p_lt16 {
        // nz_lo = 256^p, mul_hi = 256^(16-p)
        let (q, r) = DivRem::div_rem(u.low, nz_lo);
        (u.high.into() * mul_hi + q.into(), r.into())
    } else {
        // nz_lo = 256^(p-16), mul_hi = 2^128
        let (q, r) = DivRem::div_rem(u.high, nz_lo);
        (q.into(), r.into() * mul_hi + u.low.into())
    }
}


/// Encodes the < 93-byte tail: `left` full words at s[0..left], then (pending, plen) at s[left],
/// s[left+1].
fn b64_tail(
    ref out: ByteArray, s: Span<felt252>, left: usize, t: Span<felt252>, t6: Span<felt252>,
) {
    let pending = *s[left];
    let plen: usize = (*s[left + 1]).try_into().unwrap();
    let r = left * 31 + plen;
    if r == 0 {
        return;
    }
    let pw = B64_POW256.span();
    let last = if plen == 0 {
        0
    } else {
        pending * *pw[31 - plen]
    };
    let (w0, w1, w2) = if left == 0 {
        (last, 0, 0)
    } else if left == 1 {
        (*s[0], last, 0)
    } else {
        (*s[0], *s[1], last)
    };
    let (o0, o1, o2, o3) = b64_block(w0, w1, w2, t, t6);
    let nc = (r + 2) / 3 * 4; // chars to emit (<= 124)
    let pad = (3 - r % 3) % 3; // trailing 'A's to turn into '=' ('A' - '=' == 4)
    let os = array![o0, o1, o2, o3];
    let mut i: usize = 0;
    while i * 31 < nc {
        let mut v = *os[i];
        if pad >= 1 && (nc - 1) / 31 == i {
            v -= 4 * *pw[30 - (nc - 1) % 31];
        }
        if pad == 2 && (nc - 2) / 31 == i {
            v -= 4 * *pw[30 - (nc - 2) % 31];
        }
        let len = if nc - i * 31 >= 31 {
            31
        } else {
            nc - i * 31
        };
        if len == 31 {
            out.append_word(v, 31);
        } else {
            let vu: u256 = v.into();
            let d: u256 = (*pw[31 - len]).into();
            let top: felt252 = (vu / d).try_into().unwrap();
            out.append_word(top, len);
        }
        i += 1;
    }
}


/// Standard base64 (RFC 4648, with '=' padding), appended to `out`.
///
/// Reads the input as 31-byte words (Serde) and encodes 93 bytes -> 124 chars per step with a
/// 4096-entry 12-bit -> 2-char table, emitting whole 31-char words. If `out` ends mid-word (p =
/// out.len() % 31 != 0) the encoded words are re-split at p so `out` stays 31-aligned and the body
/// is appended with an aligned `append`.
pub fn append_base64(ref out: ByteArray, input: @ByteArray) {
    let mut words: Array<felt252> = array![];
    input.serialize(ref words);
    let mut s = words.span();
    let n_full: usize = (*s.pop_front().unwrap()).try_into().unwrap();
    let t = B64_T12.span();
    let t6 = B64_T6.span();
    let nblocks = n_full / 3;
    let mut left = n_full;
    if nblocks > 0 {
        let p = out.len() % 31;
        if p == 0 {
            let mut enc: Array<felt252> = array![(nblocks * 4).into()];
            while left >= 3 {
                let [w0, w1, w2] = (*s.multi_pop_front::<3>().unwrap()).unbox();
                let (o0, o1, o2, o3) = b64_block(w0, w1, w2, t, t6);
                enc.append(o0);
                enc.append(o1);
                enc.append(o2);
                enc.append(o3);
                left -= 3;
            }
            enc.append(0);
            enc.append(0);
            let mut es = enc.span();
            let body: ByteArray = Serde::deserialize(ref es).unwrap();
            out.append(@body);
        } else {
            let pw = B64_POW256.span();
            let p_lt16 = p < 16;
            let p_eq16 = p == 16;
            let (lo_div, mul_hi) = if p_lt16 {
                (*pw[p], *pw[16 - p])
            } else if p_eq16 {
                (2, 0)
            } else {
                (*pw[p - 16], *pw[16])
            };
            let lo_u128: u128 = lo_div.try_into().unwrap();
            let nz_lo: NonZero<u128> = lo_u128.try_into().unwrap();
            let sh = *pw[31 - p];
            // first block: its first word's top completes out's pending word.
            let [w0, w1, w2] = (*s.multi_pop_front::<3>().unwrap()).unbox();
            let (o0, o1, o2, o3) = b64_block(w0, w1, w2, t, t6);
            left -= 3;
            let (top0, bot0) = b64_split_word(o0, p_lt16, p_eq16, nz_lo, mul_hi);
            out.append_word(top0, 31 - p);
            let mut enc: Array<felt252> = array![(nblocks * 4 - 1).into()];
            let (top1, bot1) = b64_split_word(o1, p_lt16, p_eq16, nz_lo, mul_hi);
            enc.append(bot0 * sh + top1);
            let (top2, bot2) = b64_split_word(o2, p_lt16, p_eq16, nz_lo, mul_hi);
            enc.append(bot1 * sh + top2);
            let (top3, bot3) = b64_split_word(o3, p_lt16, p_eq16, nz_lo, mul_hi);
            enc.append(bot2 * sh + top3);
            let mut prev = bot3;
            while left >= 3 {
                let [w0, w1, w2] = (*s.multi_pop_front::<3>().unwrap()).unbox();
                let (o0, o1, o2, o3) = b64_block(w0, w1, w2, t, t6);
                let (a0, b0) = b64_split_word(o0, p_lt16, p_eq16, nz_lo, mul_hi);
                enc.append(prev * sh + a0);
                let (a1, b1) = b64_split_word(o1, p_lt16, p_eq16, nz_lo, mul_hi);
                enc.append(b0 * sh + a1);
                let (a2, b2) = b64_split_word(o2, p_lt16, p_eq16, nz_lo, mul_hi);
                enc.append(b1 * sh + a2);
                let (a3, b3) = b64_split_word(o3, p_lt16, p_eq16, nz_lo, mul_hi);
                enc.append(b2 * sh + a3);
                prev = b3;
                left -= 3;
            }
            enc.append(0);
            enc.append(0);
            let mut es = enc.span();
            let body: ByteArray = Serde::deserialize(ref es).unwrap();
            out.append(@body);
            out.append_word(prev, p);
        }
    }
    b64_tail(ref out, s, left, t, t6);
}

pub fn base64(input: @ByteArray) -> ByteArray {
    let mut out: ByteArray = Default::default();
    append_base64(ref out, input);
    out
}
