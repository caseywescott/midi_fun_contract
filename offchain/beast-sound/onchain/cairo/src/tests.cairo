}

/// Baseline: what the NFT does without sound for the same Beast (one base64 pass over the JSON).
#[test]
fn baseline_today_warlock() {
    let mut json: ByteArray = "{";
    json.append(@warlock_members());
    json.append(@",\"image\":\"data:image/svg+xml;base64,");
    json.append(@warlock_svg_b64());
    json.append(@"\"}");
    let mut uri: ByteArray = "data:application/json;base64,";
    uri.append(@base64(@json));
    assert!(uri.len() > 0);
}
