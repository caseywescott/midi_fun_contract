 src/lib.cairo                | 14 +++++++
 src/metadata_generator.cairo | 74 +++++++++++++++++++++++++++---------
 src/sound_page_tests.cairo   | 74 ++++++++++++++++++++++++++++++++++++
 4 files changed, 170 insertions(+), 19 deletions(-)
