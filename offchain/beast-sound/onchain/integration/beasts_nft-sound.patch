+    /// JSON members for the Beast Sound page: name, description and attributes, without braces
+    /// and without `image`. Returns them with the SVG base64, which the page places itself.
+    fn components_to_members(components: MetadataComponents) -> (ByteArray, ByteArray) {
+        let MetadataComponents { name, description, image_svg_b64, attributes } = components;
+        let mut json: ByteArray = "\"name\":\"";
+        json.append(@name);
+        json.append(@"\",\"description\":\"");
+        json.append(@description);
+        json.append(@"\",");
+        Self::append_attributes(ref json, @attributes);
+        (json, image_svg_b64)
+    }
+
+    fn append_attributes(ref json: ByteArray, attributes: @Array<Attribute>) {
         json.append(@"\"attributes\":[");
 
         let mut i = 0;
-        let attributes_len = components.attributes.len();
+        let attributes_len = attributes.len();
         loop {
             if i >= attributes_len {
                 break;
             }
 
-            let attr = components.attributes.at(i);
+            let attr = attributes.at(i);
             json.append(@"{\"trait_type\":\"");
-            json.append(@attr.trait_type.clone());
+            json.append(attr.trait_type);
             json.append(@"\",\"value\":\"");
-            json.append(@attr.value.clone());
+            json.append(attr.value);
             json.append(@"\"}");
 
             if i < attributes_len - 1 {
