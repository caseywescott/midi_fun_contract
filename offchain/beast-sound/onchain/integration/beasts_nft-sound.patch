+/// Sound page (`beast_sound_page::MidiSoundPage`): returns the full token_uri with an
+/// `animation_url` that plays the token's music. `members` is the metadata JSON body without
+/// braces and without `image`; `svg_b64` is the base64 SVG that `image` would carry. The page's
+/// MIDI provider composes from `(token_address, token_id)` alone, reading this contract's state
+/// getters (never `token_uri`).
+#[starknet::interface]
+pub trait IMidiSoundPage<TContractState> {
+    fn token_uri(
+        self: @TContractState,
+        members: ByteArray,
+        svg_b64: ByteArray,
+        token_address: ContractAddress,
+        token_id: u256,
+    ) -> ByteArray;
+}
