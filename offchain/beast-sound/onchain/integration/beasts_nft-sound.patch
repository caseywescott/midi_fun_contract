+
+/// Live stats the Beast Sound composer reads to write a Beast's theme.
+#[derive(Copy, Drop, Serde)]
+pub struct BeastSoundInputs {
+    pub adventurers_killed: u64,
+    pub scars: u64,
+    pub summit_held_seconds: u64,
+    pub rank: u16,
+    pub species_count: u16,
+}
+
+/// Beast Sound page contract: builds the full token_uri with an `animation_url` that plays the
+/// Beast's theme. `members` is the metadata JSON body without braces and without `image`;
+/// `svg_b64` is the base64 SVG that `image` would carry.
+#[starknet::interface]
+pub trait IBeastSoundPage<TContractState> {
+    fn token_uri(
+        self: @TContractState,
+        members: ByteArray,
+        svg_b64: ByteArray,
+        token_id: u256,
+        live: BeastSoundInputs,
+    ) -> ByteArray;
+}
