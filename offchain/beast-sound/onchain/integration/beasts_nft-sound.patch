@@ -0,0 +1,107 @@
+use beasts_nft::interfaces::{IBeastsDispatcher, IBeastsDispatcherTrait};
+use beasts_nft::metadata_generator::{Attribute, MetadataComponents, MetadataGeneratorTrait};
+use openzeppelin_interfaces::erc721::{IERC721MetadataDispatcher, IERC721MetadataDispatcherTrait};
+use snforge_std::{
+    ContractClassTrait, DeclareResultTrait, declare, start_cheat_caller_address, start_mock_call,
+    stop_cheat_caller_address,
+};
+use starknet::ContractAddress;
+
+fn addr(a: felt252) -> ContractAddress {
+    a.try_into().unwrap()
+}
+
+fn deploy_with_minted_beast() -> (IBeastsDispatcher, IERC721MetadataDispatcher, u256) {
+    let provider = addr('provider');
+    let img: ByteArray =
+        "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAAEElEQVR4nGP4z8DAwMAAAgABAAJcQp0pAAAAAElFTkSuQmCC";
+    start_mock_call(provider, selector!("get_data_uri"), img);
+
+    let mut calldata: Array<felt252> = array![];
+    let name: ByteArray = "Beasts";
+    let symbol: ByteArray = "BEAST";
+    name.serialize(ref calldata);
+    symbol.serialize(ref calldata);
+    addr('owner').serialize(ref calldata);
+    addr('royalty').serialize(ref calldata);
+    500_u128.serialize(ref calldata);
+    provider.serialize(ref calldata);
+    provider.serialize(ref calldata);
+    provider.serialize(ref calldata);
+    provider.serialize(ref calldata);
+    0.serialize(ref calldata);
+    let (nft, _) = declare("beasts_nft").unwrap().contract_class().deploy(@calldata).unwrap();
+    let beasts = IBeastsDispatcher { contract_address: nft };
+
+    start_cheat_caller_address(nft, addr('owner'));
+    beasts.set_dungeon_address(addr('minter'));
+    stop_cheat_caller_address(nft);
+    start_cheat_caller_address(nft, addr('minter'));
+    let (token_id, _, _) = beasts.mint(addr('holder'), 1, 33, 10, 126, 229, 0, 0);
+    stop_cheat_caller_address(nft);
+    (beasts, IERC721MetadataDispatcher { contract_address: nft }, token_id)
+}
+
+fn set_page(beasts: IBeastsDispatcher, page: ContractAddress) {
+    start_cheat_caller_address(beasts.contract_address, addr('owner'));
+    beasts.set_sound_page_address(page);
+    stop_cheat_caller_address(beasts.contract_address);
+}
+
+#[test]
+fn sound_page_defaults_to_zero_and_keeps_token_uri() {
+    let (beasts, metadata, token_id) = deploy_with_minted_beast();
+    assert!(beasts.get_sound_page_address() == 0.try_into().unwrap());
+    let before = metadata.token_uri(token_id);
+
+    // Turning sound on and back off restores the original bytes.
+    let page = addr('sound_page');
+    let from_page: ByteArray = "data:application/json;base64,c291bmQ=";
+    start_mock_call(page, selector!("token_uri"), from_page);
+    set_page(beasts, page);
+    assert!(metadata.token_uri(token_id) != before);
+    set_page(beasts, 0.try_into().unwrap());
+    assert!(metadata.token_uri(token_id) == before);
+}
+
+#[test]
+fn token_uri_delegates_to_sound_page() {
+    let (beasts, metadata, token_id) = deploy_with_minted_beast();
+    let page = addr('sound_page');
+    let from_page: ByteArray = "data:application/json;base64,c291bmQ=";
+    start_mock_call(page, selector!("token_uri"), from_page.clone());
+    set_page(beasts, page);
+    assert!(beasts.get_sound_page_address() == page);
+    assert!(metadata.token_uri(token_id) == from_page);
+}
+
+#[test]
+#[should_panic(expected: ('Caller is not the owner',))]
+fn only_owner_sets_sound_page() {
+    let (beasts, _, _) = deploy_with_minted_beast();
+    start_cheat_caller_address(beasts.contract_address, addr('someone'));
+    beasts.set_sound_page_address(addr('sound_page'));
+}
+
+fn components() -> MetadataComponents {
+    let attributes = array![
+        Attribute { trait_type: "Rank", value: "1" }, Attribute { trait_type: "Shiny", value: "0" },
+    ];
+    MetadataComponents {
+        name: "Warlock", description: "A test beast", image_svg_b64: "PHN2Zy8+", attributes,
+    }
+}
+
+/// The page gets the same members and image as the plain JSON, minus the image member.
+#[test]
+fn sound_page_members_match_the_plain_json() {
+    let json = MetadataGeneratorTrait::components_to_json(components());
+    let (members, svg_b64) = MetadataGeneratorTrait::components_to_members(components());
+    assert!(svg_b64 == "PHN2Zy8+");
+    assert!(
+        members == "\"name\":\"Warlock\",\"description\":\"A test beast\",\"attributes\":[{\"trait_type\":\"Rank\",\"value\":\"1\"},{\"trait_type\":\"Shiny\",\"value\":\"0\"}]",
+    );
+    assert!(
+        json == "{\"name\":\"Warlock\",\"description\":\"A test beast\",\"image\":\"data:image/svg+xml;base64,PHN2Zy8+\",\"attributes\":[{\"trait_type\":\"Rank\",\"value\":\"1\"},{\"trait_type\":\"Shiny\",\"value\":\"0\"}]}",
+    );
+}
