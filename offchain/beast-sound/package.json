{
  "name": "beast-sound",
  "version": "1.0.0",
  "description": "Offchain Beast Sound: turn any Loot Survivor Beast (token ID + live stats) into its canonical canon, MIDI file and compact BSN1 note stream. Output matches the Cairo reference byte for byte.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./engine": "./src/engine.js",
    "./chain": "./src/chain.js",
    "./inputs": {
      "types": "./inputs.d.ts",
      "default": "./src/inputs.js"
    }
  },
  "bin": {
    "beast-sound": "./bin/beast-sound.mjs"
  },
  "files": [
    "README.md",
    "bin",
    "index.d.ts",
    "server",
    "src",
    "inputs.d.ts"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "snes:build": "node onchain/snes/build.mjs",
    "snes:build:12k": "node onchain/snes/build.mjs onchain/snes/manifest-12k.json onchain/snes/dist-12k",
    "snes:import": "node onchain/snes/import-vsco.mjs",
    "snes:render": "node onchain/snes/render-demo.mjs",
    "snes:render:12k": "node onchain/snes/render-demo.mjs onchain/snes/dist-12k",
    "snes:test": "node --test test/snes.test.mjs",
    "serve": "node server/build.mjs && node server/node.mjs",
    "snes:ab": "node onchain/snes/build.mjs && node onchain/snes/build.mjs onchain/snes/manifest-12k.json onchain/snes/dist-12k && node onchain/snes/ab.mjs"
  },
  "dependencies": {
    "@scure/starknet": "^2.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.23.0"
  }
}
